{%- comment -%} Params: share_label, instagram_url {%- endcomment -%}
{%- assign ah_share_url = shop.url | append: article.url | url_encode -%}
{%- assign ah_share_title = article.title | url_encode -%}
          <div class="article-header__share">
            <span class="article-header__share-label">{{ share_label }}</span>
            <div class="article-header__share-icons">
              <button type="button" class="article-header__share-btn" data-ah-share data-title="{{ article.title | escape }}" data-url="{{ shop.url }}{{ article.url }}" aria-label="Share">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 4l8 8-8 8v-5c-6 0-10 1.5-12 5 .5-7 4-11 12-12V4z"/></svg>
              </button>
              {% if instagram_url != blank %}
                <a class="article-header__share-btn" href="{{ instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 2h10a5 5 0 015 5v10a5 5 0 01-5 5H7a5 5 0 01-5-5V7a5 5 0 015-5zm5 5.5A4.5 4.5 0 1016.5 12 4.5 4.5 0 0012 7.5zm0 2A2.5 2.5 0 1114.5 12 2.5 2.5 0 0112 9.5zm5-4.2a1.1 1.1 0 101.1 1.1A1.1 1.1 0 0017 5.3z"/></svg>
                </a>
              {% endif %}
              <a class="article-header__share-btn" href="https://www.facebook.com/sharer/sharer.php?u={{ ah_share_url }}" target="_blank" rel="noopener" aria-label="Facebook">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 00-1.6 19.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.3v7A10 10 0 0012 2z"/></svg>
              </a>
              <a class="article-header__share-btn" href="https://wa.me/?text={{ ah_share_title }}%20{{ ah_share_url }}" target="_blank" rel="noopener" aria-label="WhatsApp">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2zm5.2 13.9c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.2-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.8s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.1 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1c.2-.3.4-.2.6-.1l2 1c.3.1.5.2.5.3.1.2.1.7-.1 1.2z"/></svg>
              </a>
            </div>
          </div>
        
{%- unless share_script_loaded -%}
<script>
  if (!window.__articleShareInit) {
    window.__articleShareInit = true;
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-ah-share]');
      if (!btn) return;
      var data = { title: btn.dataset.title, url: btn.dataset.url };
      if (navigator.share) {
        navigator.share(data).catch(function () {});
      } else if (navigator.clipboard) {
        navigator.clipboard.writeText(data.url);
        btn.setAttribute('aria-label', 'Link copied');
      }
    });
  }
</script>
{%- endunless -%}
