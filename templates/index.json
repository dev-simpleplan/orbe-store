    "see-through": {
      "type": "see-through",
      "blocks": {
        "qa_item_1": {
          "type": "qa_item",
          "settings": {
            "question": "Do I really need a supplement?",
            "answer": "Maybe not. If your diet consistently gives you iron, D3, B12, folate and omega-3, you're covered. Most Indian women's blood work says otherwise. n01 fills the gaps that show up most often."
          }
        },
        "qa_item_2": {
          "type": "qa_item",
          "settings": {
            "question": "How long until I feel something?",
            "answer": "Weeks, not days. Nutrients replenish quietly; they don't stimulate. Most women notice steadier energy around week 4 to 6. Any brand promising 7 days is selling you something else."
          }
        },
        "qa_item_3": {
          "type": "qa_item",
          "settings": {
            "question": "Why isn't food alone enough?",
            "answer": "Even careful eaters fall short on a few nutrients, consistently. A supplement covers the 10% your plate keeps missing."
          }
        },
        "qa_item_4": {
          "type": "qa_item",
          "settings": {
            "question": "Are there side effects?",
            "answer": "n01 uses gentle, well-studied forms at maintenance doses. Ferrochel® iron skips the constipation common with cheaper iron. Take it with breakfast and you're fine."
          }
        },
        "qa_item_5": {
          "type": "qa_item",
          "settings": {
            "question": "Do I need a doctor's prescription?",
            "answer": "No. It's dosed for everyday maintenance. If you're pregnant, on medication, or managing a condition, check with your doctor first. That's just sensible."
          }
        },
        "qa_item_6": {
          "type": "qa_item",
          "settings": {
            "question": "What if it doesn't suit me?",
            "answer": "30 days, full refund, keep the bottle. We'd rather you start somewhere than nowhere."
          }
        }
      },
