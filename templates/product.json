          "type": "faq_item",
          "settings": {
            "question": "Can I take Orbé every day?",
            "answer": "Yes. It’s designed to be gentle, balanced, and safe for daily use. Consistency is where the transformation happens."
          }
        },
        "faq_item_cN46Ja": {
          "type": "faq_item",
          "settings": {
            "question": "Can anyone take an overall wellness supplement?",
            "answer": "Most adults can. If you're pregnant, breastfeeding, or managing a medical condition, check in with a professional first."
          }
        },
        "faq_item_DwHmci": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need a prescription?",
            "answer": "No. Orbé is a daily wellness supplement, not a medication. It can be taken without a prescription."
          }
        },
        "faq_item_7ACbPH": {
          "type": "faq_item",
          "settings": {
            "question": "Will it upset my stomach?",
            "answer": "Unlikely. We use gentle, chelated minerals like Ferrochel® iron and magnesium bisglycinate that are easy on digestion."
          }
        },
        "faq_item_iPNtek": {
          "type": "faq_item",
          "settings": {
            "question": "What makes Orbé different from other supplements?",
            "answer": "A pill-in-pill design that protects potency, clinically validated nutrients, and clean, intentional formulation."
          }
        },
        "faq_item_eG4BrW": {
          "type": "faq_item",
          "settings": {
            "question": "Is it safe to take long-term?",
            "answer": "Yes. Orbé is crafted with clean ingredients and balanced dosing for daily foundational support."
          }
        },
        "faq_item_Dyij7B": {
          "type": "faq_item",
          "settings": {
            "question": "Can I take Orbé with other supplements?",
            "answer": "In most cases, yes, but it’s helpful to avoid doubling nutrients. If you’re unsure, a quick professional check-in is wise."
          }
        },
        "faq_item_UNE9pY": {
          "type": "faq_item",
          "settings": {
