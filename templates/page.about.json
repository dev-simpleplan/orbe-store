    "letter-from-founder": {
      "type": "letter-from-founder",
      "settings": {
        "background_image": "shopify://shop_images/Rectangle_3468571.png",
        "heading": "A Letter From Our Founder",
        "founder_image": "shopify://shop_images/Rectangle_3468573_1_1.jpg",
        "letter_text": "<p>The conversation around women’s wellness has grown far too loud. Orbé exists to be the quiet pause.</p><p>By marrying uncompromising science with elegant minimalism, Orbé strips away the excess, leaving only what is pure and essential. It is a space where the noise fades, empowering women to tune back into their bodies with absolute confidence.</p><p>Because caring for yourself shouldn't be a complication. It should be a beautifully effortless ritual.</p>",
        "signature_image": "shopify://shop_images/image_551.jpg",
        "signature_text": "Founder, Orbé"
      }
    },
