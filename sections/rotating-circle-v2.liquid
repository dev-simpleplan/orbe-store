{%- assign rc_count = section.blocks.size | at_most: 4 -%}
<section class="rc2" id="rc2-{{ section.id }}" data-rc2 style="--rc2-steps: {{ rc_count }};">
  <div class="rc2-sticky">

    {% if section.settings.heading != blank or section.settings.description != blank %}
      <div class="container">
        <div class="rc2-head">
          {% if section.settings.heading != blank %}
            <h2 class="rc2-heading">{% render 'emphasis-text', text: section.settings.heading %}</h2>
          {% endif %}
          {% if section.settings.description != blank %}
            <p class="rc2-desc">{{ section.settings.description }}</p>
          {% endif %}
        </div>
      </div>
    {% endif %}

    <div class="rc2-scene" data-rc2-scene>
      <div class="rc2-ring" data-rc2-ring>
        <span class="rc2-accent rc2-accent--left"></span>
        <span class="rc2-accent rc2-accent--right"></span>
      </div>

      {% for block in section.blocks limit: 4 %}
        <span class="rc2-dot" data-rc2-dot {{ block.shopify_attributes }}></span>
      {% endfor %}

      {% for block in section.blocks limit: 4 %}
        <div class="rc2-label" data-rc2-label>
          {% if block.settings.title != blank %}<span class="rc2-label-title">{{ block.settings.title }}</span>{% endif %}
          {% if block.settings.text != blank %}<span class="rc2-label-sub">{{ block.settings.text }}</span>{% endif %}
        </div>
      {% endfor %}

      <div class="rc2-blob" data-rc2-blob>
        <div class="rc2-blob-inner" data-rc2-spin>
        {% if section.settings.video != blank %}
          {% assign rc_sources = section.settings.video.sources | where: 'mime_type', 'video/mp4' %}
          <video class="rc2-video" muted playsinline webkit-playsinline preload="auto" tabindex="-1" aria-hidden="true">
            {% for source in rc_sources %}
              <source src="{{ source.url }}" type="{{ source.mime_type }}">
            {% endfor %}
          </video>
        {% else %}
          {% if section.settings.image_1 != blank %}
            <div class="rc2-slide is-active">{{ section.settings.image_1 | image_url: width: 900 | image_tag: loading: 'lazy', alt: '' }}</div>
          {% endif %}
          {% if section.settings.image_2 != blank %}
            <div class="rc2-slide{% if section.settings.image_1 == blank %} is-active{% endif %}">{{ section.settings.image_2 | image_url: width: 900 | image_tag: loading: 'lazy', alt: '' }}</div>
          {% endif %}
        {% endif %}
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  (function () {
    function init() {
      if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
        setTimeout(init, 100);
        return;
      }
      gsap.registerPlugin(ScrollTrigger);

      var wrapper = document.getElementById('rc2-{{ section.id }}');
      if (!wrapper || wrapper.dataset.rc2Ready === 'true') return;
      wrapper.dataset.rc2Ready = 'true';

      var sticky = wrapper.querySelector('.rc2-sticky');
      var scene = wrapper.querySelector('[data-rc2-scene]');
      var ring = wrapper.querySelector('[data-rc2-ring]');
      var dots = Array.prototype.slice.call(wrapper.querySelectorAll('[data-rc2-dot]'));
      var labels = Array.prototype.slice.call(wrapper.querySelectorAll('[data-rc2-label]'));
      var slides = Array.prototype.slice.call(wrapper.querySelectorAll('.rc2-slide'));
      var video = wrapper.querySelector('.rc2-video');
      var spin = wrapper.querySelector('[data-rc2-spin]');
      var mobileMq = window.matchMedia('(max-width: 767px)');
      var swapAt = 0.82;
      var activeSlide = -1;
      var duration = 0;
      var target = 0;
      var seeking = false;
      var primed = false;

      // ---------- video scrubbing (same approach as the original rotating circle) ----------
      function seekNow() {
        if (!video) return;
        seeking = true;
        if (!video.paused) video.pause();
        video.currentTime = target;
      }
      function seekVideo(t) {
        target = t;
        if (video && !seeking) seekNow();
      }
      if (video) {
        video.addEventListener('seeked', function () {
          seeking = false;
          if (Math.abs(video.currentTime - target) > 0.02) seekNow();
        });
        var prime = function () {
          if (primed) return;
          duration = video.duration || 0;
          var done = function () { video.pause(); video.currentTime = 0; primed = true; update(); };
          var p = video.play();
          if (p && typeof p.then === 'function') p.then(done).catch(done); else done();
        };
        video.autoplay = false;
        video.addEventListener('play', function () { if (primed) video.pause(); });
        if (video.readyState >= 2) prime(); else video.addEventListener('loadeddata', prime, { once: true });
      }

      if (!scene || !ring || !dots.length || !labels.length) return;

      // ---------- placing dots + cards around the ring ----------
      // t = which card is "in focus" (0 = first card, 1 = second ...). Card i sits at an angle of
      // focus + (i - t) * step, so as t grows the next card travels round the ring to the focus
      // slot (top-right on desktop) and grows; the card that was in focus moves on and shrinks back.
      var MIN_SCALE = 0.92;
      var MAX_SCALE = 1.4;

      function place(t) {
        var size = ring.offsetWidth;
        var cx = ring.offsetLeft + size / 2;
        var cy = ring.offsetTop + size / 2;
        var r = size / 2 - 1;
        var count = Math.min(dots.length, labels.length);
        var sceneW = scene.offsetWidth;
        var mobile = mobileMq.matches;

        // desktop/tablet: cards evenly round the ring, focus slot at the top-right (-45deg)
        // mobile: the ring is half off screen, so the focus slot is the top-left of the visible half
        // and the cards are closer together
        var step = mobile ? 75 : 360 / count;
        var focus = mobile ? 240 : -45;

        for (var i = 0; i < count; i++) {
          var angle = focus + (i - t) * step;
          var a = angle * Math.PI / 180;
          var dx = Math.cos(a), dy = Math.sin(a);
          var dotX = cx + dx * r, dotY = cy + dy * r;
          dots[i].style.left = dotX + 'px';
          dots[i].style.top = dotY + 'px';

          // 1 when the card is at the focus slot, 0 when it is a full step away
          var near = Math.max(0, 1 - Math.abs(i - t));
          var scale = (mobile ? 0.9 : MIN_SCALE) + ((mobile ? 1.2 : MAX_SCALE) - (mobile ? 0.9 : MIN_SCALE)) * near;
          var w = labels[i].offsetWidth * scale;
          var lx, ly;

          if (mobile) {
            lx = Math.max(w / 2 + 14, dotX - 22 - w / 2);
            ly = dotY;
            var visible = dotX < sceneW - 6;
            labels[i].style.opacity = visible ? '1' : '0';
            dots[i].style.opacity = visible ? '1' : '0';
          } else {
            // the more horizontal, the further out, so wide cards never cover the dots
            var horiz = Math.abs(dx);
            var lr = r + 52 + horiz * (w / 2 + 16) + (scale - 1) * 40;
            lx = cx + dx * lr;
            ly = cy + dy * lr;
            labels[i].style.opacity = '1';
            dots[i].style.opacity = '1';
          }
          labels[i].style.left = lx + 'px';
          labels[i].style.top = ly + 'px';
          labels[i].style.transform = 'translate(-50%, -50%) scale(' + scale.toFixed(3) + ')';
          labels[i].style.zIndex = near > 0.5 ? '5' : '3';
          labels[i].classList.toggle('is-focus', near > 0.5);
          dots[i].style.transform = 'translate(-50%, -50%) scale(' + (1 + 0.5 * near).toFixed(3) + ')';
        }
      }

      function setSlide(i) {
        if (!slides.length || activeSlide === i) return;
        activeSlide = i;
        slides.forEach(function (s, idx) { s.classList.toggle('is-active', idx === i); });
      }

      // mobile: pin a box that is only as tall as its content (no big white gaps),
      // centred on the screen but never under the header
      function layoutPin() {
        if (!mobileMq.matches) {
          wrapper.style.removeProperty('--rc2-h');
          wrapper.style.removeProperty('--rc2-top');
          return;
        }
        var h = sticky.offsetHeight;
        wrapper.style.setProperty('--rc2-h', h + 'px');
        wrapper.style.setProperty('--rc2-top', Math.max(76, (window.innerHeight - h) / 2) + 'px');
      }
      layoutPin();

      function update() {
        var rect = wrapper.getBoundingClientRect();
        // the pinned box is 100vh on desktop; on mobile it is only as tall as its content
        var pinTop = parseFloat(getComputedStyle(sticky).top) || 0;
        var distance = Math.max(1, wrapper.offsetHeight - sticky.offsetHeight);
        var progress = gsap.utils.clamp(0, 1, (pinTop - rect.top) / distance);
        var count = Math.max(1, Math.min(dots.length, labels.length));
        // small hold at the start and end so the first and last card each get a moment in focus
        var move = gsap.utils.clamp(0, 1, (progress - 0.06) / 0.88);
        var t = move * (count - 1);

        gsap.set(ring, { rotation: move * 25 });
        if (spin) gsap.set(spin, { rotation: progress * 240 });
        place(t);

        if (video && duration) {
          if (!video.paused) video.pause();
          seekVideo(gsap.utils.clamp(0, duration - 0.05, progress * duration));
        } else {
          setSlide(progress >= swapAt && slides.length > 1 ? 1 : 0);
        }
      }

      var existing = ScrollTrigger.getById('rc2-{{ section.id }}');
      if (existing) existing.kill();

      ScrollTrigger.create({
        id: 'rc2-{{ section.id }}',
        trigger: wrapper,
        start: 'top top',
        end: 'bottom bottom',
        scrub: true,
        invalidateOnRefresh: true,
        onRefresh: update,
        onUpdate: update
      });

      if (window.lenis && typeof window.lenis.on === 'function') window.lenis.on('scroll', update);
      else window.addEventListener('scroll', update, { passive: true });

      var t;
      window.addEventListener('resize', function () { clearTimeout(t); t = setTimeout(function () { layoutPin(); update(); }, 120); });
      requestAnimationFrame(function () { update(); ScrollTrigger.refresh(); });
      window.addEventListener('load', function () { layoutPin(); update(); ScrollTrigger.refresh(); }, { once: true });
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>

{% schema %}
{
  "name": "Rotating Circle (V2)",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Science Backed *Formulation*",
      "info": "Wrap words in *asterisks* to make them italic, anywhere in the sentence."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Every nutrient comes in a form chosen for how well your body absorbs it."
    },
    {
      "type": "header",
      "content": "Centre"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Center video",
      "info": "Scrubs with scroll. If set, it replaces the two images below."
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    }
  ],
  "blocks": [
    {
      "type": "text_item",
      "name": "Text Item",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rotating Circle (V2)",
      "blocks": [
        {
          "type": "text_item",
          "settings": {
            "title": "System-Level Formulation",
            "text": "Designed for synergy, not stimulation."
          }
        },
        {
          "type": "text_item",
          "settings": {
            "title": "Steady Energy Pathways",
            "text": "Helps reduce peaks and crashes."
          }
        },
        {
          "type": "text_item",
          "settings": {
            "title": "Dose-Aware Design",
            "text": "Respects the body's natural balance."
          }
        },
        {
          "type": "text_item",
          "settings": {
            "title": "Optimised Bioavailability",
            "text": "Supports efficient absorption and use."
          }
        }
      ]
    }
  ]
}
{% endschema %}
