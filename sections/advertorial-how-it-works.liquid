{%- assign ah_id = 'advertorial-how-' | append: section.id -%}
{%- assign ah_count = section.blocks.size | at_least: 1 -%}

{%- style -%}
  #{{ ah_id }} {
    --ah-accent: {{ section.settings.accent_color }};
    --ah-count: {{ ah_count }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
  }

  #{{ ah_id }} .ah-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 80px;
    align-items: center;
  }

  #{{ ah_id }} .ah-grid.is-image-left .ah-media {
    order: -1;
  }

  #{{ ah_id }} .ah-eyebrow {
    margin: 0 0 30px;
    color: var(--ah-accent);
    font-family: var(--aspekta);
    font-size: 15px;
    line-height: 150%;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #{{ ah_id }} .ah-title {
    margin: 0 0 28px;
    max-width: 11em;
    color: {{ section.settings.heading_color }};
    font-family: var(--tobias);
    font-size: clamp(34px, 3.8vw, 56px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  #{{ ah_id }} .ah-text {
    margin: 0;
    max-width: 30em;
    color: {{ section.settings.text_color }};
    font-family: var(--aspekta);
    font-size: 16px;
    line-height: 160%;
  }

  #{{ ah_id }} .ah-points {
    display: grid;
    grid-template-columns: repeat(var(--ah-count), minmax(0, 1fr));
    gap: 28px;
    max-width: 30em;
    margin-top: 44px;
  }

  #{{ ah_id }} .ah-point {
    padding-top: 14px;
    border-top: 2px solid rgba(255, 255, 255, 0.35);
  }

  #{{ ah_id }} .ah-point-title {
    margin: 0 0 8px;
    color: {{ section.settings.heading_color }};
    font-family: var(--tobias);
    font-size: 19px;
    font-weight: 400;
    line-height: 1.2;
  }

  #{{ ah_id }} .ah-point-text {
    margin: 0;
    color: {{ section.settings.text_color }};
    font-family: var(--aspekta);
    font-size: 12px;
    line-height: 150%;
  }

  #{{ ah_id }} .ah-media {
    aspect-ratio: 1.21 / 1;
    overflow: hidden;
    background: #f6f3ec;
  }

  #{{ ah_id }} .ah-media img,
  #{{ ah_id }} .ah-media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 991px) {
    #{{ ah_id }} .ah-grid {
      gap: 40px;
    }
  }

  @media (max-width: 767px) {
    #{{ ah_id }} .ah-grid {
      grid-template-columns: 1fr;
    }

    #{{ ah_id }} .ah-grid .ah-media,
    #{{ ah_id }} .ah-grid.is-image-left .ah-media {
      order: -1;
    }

    #{{ ah_id }} .ah-eyebrow {
      font-size: 12px;
      margin-bottom: 16px;
    }

    #{{ ah_id }} .ah-points {
      margin-top: 30px;
      gap: 20px;
    }

    #{{ ah_id }} .ah-point-text {
      font-size: 13px;
    }
    .advertorial-how-it-works {
      padding: 60px 0!important;
    }
  }
{%- endstyle -%}

<section class="advertorial-how-it-works" id="{{ ah_id }}">
  <div class="container">
    <div class="ah-grid{% if section.settings.image_position == 'left' %} is-image-left{% endif %}">
      <div class="ah-content">
        {% if section.settings.eyebrow != blank %}
          <p class="ah-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="ah-title">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <p class="ah-text">{{ section.settings.text }}</p>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <div class="ah-points">
            {% for block in section.blocks %}
              <div class="ah-point" {{ block.shopify_attributes }}>
                <h3 class="ah-point-title">{{ block.settings.title }}</h3>
                {% if block.settings.text != blank %}
                  <p class="ah-point-text">{{ block.settings.text }}</p>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="ah-media">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: section.settings.image.alt | default: section.settings.heading }}
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Advertorial How It Works",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A pill-in-pill built to protect every nutrient."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Paragraph",
      "default": "Some nutrients are best kept separate. ORBÉ’s two-phase capsule design keeps oil-based and powder-based ingredients apart until you swallow."
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#181716"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#D6D2CC"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Eyebrow color",
      "default": "#C8A968"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Space inside the colored background, above the content."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Space inside the colored background, below the content."
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Outer Oil"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Advertorial How It Works",
      "blocks": [
        {
          "type": "point",
          "settings": {
            "title": "Outer Oil",
            "text": "Essential fatty acids, vitamins & bone-supporting nutrients"
          }
        },
        {
          "type": "point",
          "settings": {
            "title": "Inner Powder",
            "text": "Essential minerals and B vitamins for everyday wellbeing"
          }
        }
      ]
    }
  ]
}
{% endschema %}
