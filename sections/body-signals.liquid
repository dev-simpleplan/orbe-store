{% comment %} Body Signals Section {% endcomment %}

<div class="wyb-root" data-body-signals-root-{{ section.id }}>
<section class="body-signals" id="body-signals-{{ section.id }}">
  <div class="body-signals-bg">
    {% for block in section.blocks %}
      <div class="body-signals-bg-item{% if forloop.first %} is-active{% endif %}" data-signal-bg="{{ forloop.index0 }}">
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', alt: block.settings.label }}
        {% endif %}
      </div>
    {% endfor %}
    <div class="body-signals-overlay"></div>
  </div>

  <div class="container body-signals-content">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="body-signals-head">
        {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
        {% if section.settings.subheading != blank %}<p>{{ section.settings.subheading }}</p>{% endif %}
      </div>
    {% endif %}

    <div class="body-signals-bottom">
      <div class="body-signals-tabs" role="tablist">
        {% for block in section.blocks %}
          <button
            type="button"
            class="body-signals-tab{% if forloop.first %} is-active{% endif %}"
            data-signal-tab="{{ forloop.index0 }}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            {{ block.shopify_attributes }}
          >
            <span class="body-signals-tab-dot" aria-hidden="true"></span>
            <span class="body-signals-tab-label">{{ block.settings.label }}</span>
          </button>
        {% endfor %}
      </div>

      <div class="body-signals-panels">
        {% for block in section.blocks %}
          <div class="body-signals-panel{% if forloop.first %} is-active{% endif %}" data-signal-panel="{{ forloop.index0 }}">
            {% assign panel_heading = block.settings.heading | default: block.settings.label %}
            {% if panel_heading != blank %}<h3>{{ panel_heading }}</h3>{% endif %}
            {% if block.settings.items != blank %}
              <ul>
                {% assign signal_items = block.settings.items | newline_to_br | split: '<br />' %}
                {% for item in signal_items %}
                  {% assign clean_item = item | strip %}
                  {% if clean_item != blank %}<li>{{ clean_item }}</li>{% endif %}
                {% endfor %}
              </ul>
            {% endif %}
            <a
              href="#body-signals-card-{{ section.id }}-{{ block.id }}"
              class="e-learn-more"
              data-body-card-open="{{ block.id }}"
              aria-controls="body-signals-card-{{ section.id }}-{{ block.id }}">Learn More</a>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<div class="what-your-body-card-backdrop" data-body-card-close></div>
{% for block in section.blocks %}
  <aside class="what-your-body-card desktop-cards" id="body-signals-card-{{ section.id }}-{{ block.id }}" data-body-card="{{ block.id }}" aria-hidden="true" data-lenis-prevent>
    <button type="button" class="what-your-body-card-close" aria-label="Close" data-body-card-close>
      <span></span>
      <span></span>
    </button>

    {% assign panel_heading = block.settings.heading | default: block.settings.label %}
    {% if panel_heading != blank %}
    <h3>{{ panel_heading }}</h3>
    {% endif %}

    {% if block.settings.items != blank %}
    <ul>
      {% assign card_items = block.settings.items | newline_to_br | split: '<br />' %}
      {% for item in card_items %}
        {% assign clean_item = item | strip %}
        {% if clean_item != blank %}<li>{{ clean_item }}</li>{% endif %}
      {% endfor %}
    </ul>
    {% endif %}

    {% if block.settings.rich_text != blank %}
    <div class="e-richtext">{{ block.settings.rich_text }}</div>
    {% endif %}
  </aside>
{% endfor %}
</div>

<script>
  (function () {
    function initBodySignals() {
      var section = document.getElementById('body-signals-{{ section.id }}');
      if (!section || section.dataset.signalsReady === 'true') return;

      var tabs = Array.prototype.slice.call(section.querySelectorAll('[data-signal-tab]'));
      if (!tabs.length) return;

      section.dataset.signalsReady = 'true';

      var panels = Array.prototype.slice.call(section.querySelectorAll('[data-signal-panel]'));
      var bgItems = Array.prototype.slice.call(section.querySelectorAll('[data-signal-bg]'));

      function activate(index) {
        tabs.forEach(function (tab) {
          var isActive = tab.dataset.signalTab === String(index);
          tab.classList.toggle('is-active', isActive);
          tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });
        panels.forEach(function (panel) {
          panel.classList.toggle('is-active', panel.dataset.signalPanel === String(index));
        });
        bgItems.forEach(function (bg) {
          bg.classList.toggle('is-active', bg.dataset.signalBg === String(index));
        });
      }

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          activate(tab.dataset.signalTab);
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBodySignals);
    } else {
      initBodySignals();
    }
  })();

  (function () {
    var root = document.querySelector('[data-body-signals-root-{{ section.id }}]');
    if (!root) return;

    var openButtons = root.querySelectorAll('[data-body-card-open]');
    var closeButtons = root.querySelectorAll('[data-body-card-close]');
    var cards = root.querySelectorAll('[data-body-card]');

    function closeCards() {
      root.classList.remove('body-card-active');
      cards.forEach(function (card) {
        card.setAttribute('aria-hidden', 'true');
      });
      document.documentElement.classList.remove('what-your-body-card-open');
      document.body.classList.remove('what-your-body-card-open');
      if (window.lenis) window.lenis.start();
    }

    function openCard(cardId) {
      var card = root.querySelector('[data-body-card="' + cardId + '"]');
      if (!card) return;

      cards.forEach(function (item) {
        item.setAttribute('aria-hidden', item === card ? 'false' : 'true');
      });

      root.classList.add('body-card-active');
      document.documentElement.classList.add('what-your-body-card-open');
      document.body.classList.add('what-your-body-card-open');
      if (window.lenis) window.lenis.stop();
    }

    openButtons.forEach(function (button) {
      button.addEventListener('click', function (event) {
        event.preventDefault();
        openCard(button.getAttribute('data-body-card-open'));
      });
    });

    closeButtons.forEach(function (button) {
      button.addEventListener('click', closeCards);
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && root.classList.contains('body-card-active')) {
        closeCards();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Body Signals",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Your Body's Been Trying To Tell You"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "You're not imagining it. These everyday shifts are your body's way of asking for support."
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab label",
          "default": "Energy & Fatigue"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image",
          "info": "Shown when this tab is active."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Content heading",
          "info": "Falls back to the tab label if left blank."
        },
        {
          "type": "textarea",
          "id": "items",
          "label": "Bullet items (one per line)"
        },
        {
          "type": "richtext",
          "id": "rich_text",
          "label": "Popup rich text",
          "info": "Optional. Shown inside the 'Learn More' popup, below the bullet list."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Body Signals",
      "blocks": [
        { "type": "tab", "settings": { "label": "Energy & Fatigue" } },
        { "type": "tab", "settings": { "label": "Sleep & Rest" } },
        { "type": "tab", "settings": { "label": "Mood & Clarity" } },
        { "type": "tab", "settings": { "label": "Body & Foundations" } },
        { "type": "tab", "settings": { "label": "Cycle & Hormones" } },
        { "type": "tab", "settings": { "label": "Mental Load & Overwhelm" } }
      ]
    }
  ]
}
{% endschema %}
