{%- assign acl_id = 'advertorial-climate-' | append: section.id -%}

{%- style -%}
  #{{ acl_id }} {
    --acl-accent: {{ section.settings.accent_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
  }

  #{{ acl_id }} .acl-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 60px;
    align-items: center;
  }

  #{{ acl_id }} .acl-grid.is-image-right .acl-media {
    order: 2;
  }

  #{{ acl_id }} .acl-media {
    aspect-ratio: 1.2 / 1;
    overflow: hidden;
    background: #d9cfc2;
  }

  #{{ acl_id }} .acl-media img,
  #{{ acl_id }} .acl-media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #{{ acl_id }} .acl-content {
    padding-left: 30px;
  }

  #{{ acl_id }} .acl-eyebrow {
    margin: 0 0 24px;
    color: var(--acl-accent);
    font-family: var(--aspekta);
    font-size: 15px;
    line-height: 150%;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #{{ acl_id }} .acl-title {
    margin: 0 0 22px;
    max-width: 11em;
    color: #151515;
    font-family: var(--tobias);
    font-size: clamp(34px, 3.8vw, 56px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  #{{ acl_id }} .acl-text {
    margin: 0;
    max-width: 22em;
    color: #5d5d5d;
    font-family: var(--aspekta);
    font-size: 18px;
    line-height: 125%;
  }

  @media (max-width: 991px) {
    #{{ acl_id }} .acl-grid {
      gap: 40px;
    }

    #{{ acl_id }} .acl-content {
      padding-left: 0;
    }
  }

  @media (max-width: 767px) {
    #{{ acl_id }} .acl-grid {
      grid-template-columns: 1fr;
    }

    #{{ acl_id }} .acl-grid .acl-media,
    #{{ acl_id }} .acl-grid.is-image-right .acl-media {
      order: -1;
    }

    #{{ acl_id }} .acl-eyebrow {
      font-size: 12px;
      margin-bottom: 16px;
    }

    #{{ acl_id }} .acl-text {
      font-size: 16px;
    }
    .advertorial-climate {
      padding: 60px 0!important;
    }
  }
{%- endstyle -%}

<section class="advertorial-climate" id="{{ acl_id }}">
  <div class="container">
    <div class="acl-grid{% if section.settings.image_position == 'right' %} is-image-right{% endif %}">
      <div class="acl-media">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: section.settings.image.alt | default: section.settings.heading }}
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>

      <div class="acl-content">
        {% if section.settings.eyebrow != blank %}
          <p class="acl-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="acl-title">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <p class="acl-text">{{ section.settings.text }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Advertorial Climate",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Built for India"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made with the Indian climate in mind."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Paragraph",
      "default": "Protected actives designed to stay stable through heat and humidity."
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#EBE2D8"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#A8863F"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Space inside the colored background, above the content."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Space inside the colored background, below the content."
    }
  ],
  "presets": [
    {
      "name": "Advertorial Climate"
    }
  ]
}
{% endschema %}
