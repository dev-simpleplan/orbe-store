<section class="pdp-reviews-section">
  <div class="container">
    {% if section.settings.heading != blank or section.settings.text != blank %}
      <div class="heading text-animation pdp-reviews-heading">
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.text != blank %}
          <p>{{ section.settings.text }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% render 'judgeme-reviews' %}
  </div>
</section>

{%- style -%}
  .pdp-reviews-heading {
    text-align: center;
    margin-bottom: 50px;
  }

  .pdp-reviews-heading p {
    max-width: 640px;
    margin: 12px auto 0;
  }

  @media (max-width: 767px) {
    .pdp-reviews-heading {
      margin-bottom: 30px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Product Reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Paragraph"
    }
  ],
  "presets": [
    {
      "name": "Product Reviews"
    }
  ]
}
{% endschema %}
