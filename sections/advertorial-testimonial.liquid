{%- assign at_id = 'advertorial-testimonial-' | append: section.id -%}
{%- assign slides = section.blocks | where: 'type', 'slide' -%}
{%- assign checks = section.blocks | where: 'type', 'check' -%}

{%- style -%}
  #{{ at_id }} {
    --at-accent: {{ section.settings.accent_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
  }

  #{{ at_id }} .at-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 100px;
    align-items: center;
  }

  #{{ at_id }} .at-grid.is-image-right .at-media {
    order: 2;
  }

  #{{ at_id }} .at-media {
    max-width: 470px;
    margin-left: auto;
    aspect-ratio: 0.97 / 1;
    overflow: hidden;
    background: {{ section.settings.image_placeholder_color }};
  }

  #{{ at_id }} .at-media img,
  #{{ at_id }} .at-media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #{{ at_id }} .at-eyebrow {
    margin: 0 0 6px;
    color: var(--at-accent);
    font-family: var(--aspekta);
    font-size: 15px;
    line-height: 150%;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  #{{ at_id }} .at-title {
    margin: 0;
    color: #fff;
    font-family: var(--tobias);
    font-size: clamp(34px, 3.6vw, 54px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  #{{ at_id }} .at-quote-wrap {
    position: relative;
    max-width: 590px;
    margin-top: 56px;
  }

  #{{ at_id }} .at-mark {
    position: absolute;
    width: 52px;
    color: {{ section.settings.mark_color }};
  }

  #{{ at_id }} .at-mark svg {
    display: block;
    width: 100%;
    height: auto;
  }

  #{{ at_id }} .at-mark-open {
    top: 0;
    left: -58px;
  }

  #{{ at_id }} .at-mark-close {
    right: 0;
    bottom: 0;
  }

  #{{ at_id }} .at-quote {
    margin: 0;
    color: #f2efe9;
    font-family: var(--tobias);
    font-size: clamp(20px, 1.9vw, 27px);
    font-style: italic;
    font-weight: 400;
    line-height: 1.7;
  }

  #{{ at_id }} .at-author {
    margin: 10px 0 0;
    color: #d6d2cc;
    font-family: var(--aspekta);
    font-size: 18px;
    line-height: 1.3;
  }

  @media (max-width: 991px) {
    #{{ at_id }} .at-grid {
      gap: 60px;
    }

    #{{ at_id }} .at-quote-wrap {
      padding-left: 0;
    }
  }

  @media (max-width: 767px) {
    #{{ at_id }} .at-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    #{{ at_id }} .at-grid .at-media,
    #{{ at_id }} .at-grid.is-image-right .at-media {
      order: -1;
      max-width: none;
      margin-left: 0;
    }

    #{{ at_id }} .at-eyebrow {
      font-size: 12px;
    }

    #{{ at_id }} .at-quote-wrap {
      margin-top: 36px;
      padding-top: 40px;
    }

    #{{ at_id }} .at-mark {
      width: 36px;
    }

    #{{ at_id }} .at-mark-open {
      left: 0;
      top: 0;
    }

    #{{ at_id }} .at-mark-close {
      bottom: -6px;
    }

    #{{ at_id }} .at-author {
      font-size: 16px;
    }
  }

  #{{ at_id }} .at-media {
    position: relative;
    width: 100%;
  }

  #{{ at_id }} .at-media-item {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  #{{ at_id }} .at-media-item.is-current {
    opacity: 1;
  }

  #{{ at_id }} .at-quotes {
    display: grid;
  }

  #{{ at_id }} .at-slide {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: opacity 0.5s ease, transform 0.5s ease, visibility 0.5s;
  }

  #{{ at_id }} .at-slide.is-current {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  #{{ at_id }} .at-nav {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-top: 34px;
  }

  #{{ at_id }} .at-arrows {
    display: flex;
    gap: 10px;
  }

  #{{ at_id }} .at-arrow {
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 50%;
    background: transparent;
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  #{{ at_id }} .at-arrow:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: #fff;
  }

  #{{ at_id }} .at-arrow svg {
    width: 14px;
    height: 14px;
  }

  #{{ at_id }} .at-dots {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  #{{ at_id }} .at-dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.28);
    cursor: pointer;
    transition: background 0.3s ease, transform 0.3s ease;
  }

  #{{ at_id }} .at-dot.is-current {
    background: var(--at-accent);
    transform: scale(1.25);
  }

  #{{ at_id }}-purity {
    display: none;
    background: {{ section.settings.purity_background }};
  }

  @media (max-width: 767px) {
    #{{ at_id }}-purity {
      display: block;
    }

    #{{ at_id }}-purity .ap-wrap {
      position: relative;
      min-height: 150vw;
      padding-top: 40px;
      padding-bottom: 80px;
    }

    #{{ at_id }}-purity .ap-title {
      margin: 0 0 8px;
      color: #151515;
      font-family: var(--tobias);
      font-size: clamp(30px, 8.6vw, 40px);
      font-weight: 400;
      line-height: 1.05;
      letter-spacing: -0.02em;
    }

    #{{ at_id }}-purity .ap-sub {
      margin: 0 0 28px;
      color: #6b6b6b;
      font-family: var(--aspekta);
      font-size: 16px;
      line-height: 1.3;
    }

    #{{ at_id }}-purity .ap-badge {
      position: absolute;
      top: 180px;
      right: 2%;
      z-index: 1;
      width: 27%;
    }

    #{{ at_id }}-purity .ap-badge img {
      display: block;
      width: 100%;
      height: auto;
    }

    #{{ at_id }}-purity .ap-list {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      gap: 20px;
      max-width: 62%;
    }

    #{{ at_id }}-purity .ap-item-head {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 6px;
    }

    #{{ at_id }}-purity .ap-icon {
      flex: 0 0 auto;
      width: 40px;
      height: 40px;
    }

    #{{ at_id }}-purity .ap-icon img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }

    #{{ at_id }}-purity .ap-item-title {
      margin: 0;
      color: #151515;
      font-family: var(--tobias);
      font-size: 22px;
      font-weight: 400;
      line-height: 1.1;
      letter-spacing: -0.02em;
    }

    #{{ at_id }}-purity .ap-item-text {
      margin: 0;
      color: #6b6b6b;
      font-family: var(--aspekta);
      font-size: 15px;
      line-height: 1.3;
    }

    #{{ at_id }}-purity .ap-product {
      position: absolute;
      right: 0;
      bottom: 0;
      z-index: 1;
      width: 60%;
    }

    #{{ at_id }}-purity .ap-product img {
      display: block;
      width: 100%;
      height: auto;
    }
  }
{%- endstyle -%}

<section class="advertorial-testimonial" id="{{ at_id }}" data-at data-autoplay="{{ section.settings.autoplay }}">
  <div class="container">
    <div class="at-grid{% if section.settings.image_position == 'right' %} is-image-right{% endif %}">
      <div class="at-media">
        {% for block in slides %}
          <div class="at-media-item{% if forloop.first %} is-current{% endif %}" data-at-media>
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: block.settings.author }}
            {% endif %}
          </div>
        {% endfor %}
      </div>

      <div class="at-content">
        {% if section.settings.eyebrow != blank %}
          <p class="at-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="at-title">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if slides.size > 0 %}
          <div class="at-quote-wrap">
            <span class="at-mark at-mark-open" aria-hidden="true">
              <svg viewBox="0 0 52 40" fill="currentColor"><path d="M0 40V22.5C0 9.3 7.2 1.6 20.5 0l1.6 6.2C14.6 8 11.4 12 11.2 17.6h8.9V40H0Zm29.8 0V22.5C29.8 9.3 37 1.6 50.3 0l1.7 6.2c-7.5 1.8-10.7 5.8-10.9 11.4H50V40H29.8Z"/></svg>
            </span>

            <div class="at-quotes">
              {% for block in slides %}
                <div class="at-slide{% if forloop.first %} is-current{% endif %}" data-at-slide {{ block.shopify_attributes }}>
                  <p class="at-quote">“{{ block.settings.quote }}”</p>
                  {% if block.settings.author != blank %}
                    <p class="at-author">{{ block.settings.author }}</p>
                  {% endif %}
                </div>
              {% endfor %}
            </div>

            <span class="at-mark at-mark-close" aria-hidden="true">
              <svg viewBox="0 0 52 40" fill="currentColor" style="transform: rotate(180deg)"><path d="M0 40V22.5C0 9.3 7.2 1.6 20.5 0l1.6 6.2C14.6 8 11.4 12 11.2 17.6h8.9V40H0Zm29.8 0V22.5C29.8 9.3 37 1.6 50.3 0l1.7 6.2c-7.5 1.8-10.7 5.8-10.9 11.4H50V40H29.8Z"/></svg>
            </span>
          </div>

          {% if slides.size > 1 %}
            <div class="at-nav">
              <div class="at-arrows">
                <button type="button" class="at-arrow" data-at-prev aria-label="Previous testimonial">
                  <svg viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M9 2 4 7l5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <button type="button" class="at-arrow" data-at-next aria-label="Next testimonial">
                  <svg viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="m5 2 5 5-5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              </div>
              <div class="at-dots">
                {% for block in slides %}
                  <button type="button" class="at-dot{% if forloop.first %} is-current{% endif %}" data-at-dot="{{ forloop.index0 }}" aria-label="Show testimonial {{ forloop.index }}"></button>
                {% endfor %}
              </div>
            </div>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% if checks.size > 0 or section.settings.purity_heading != blank %}
<section class="advertorial-purity" id="{{ at_id }}-purity">
  <div class="container">
    <div class="ap-wrap">
      {% if section.settings.purity_heading != blank %}
        <h2 class="ap-title">{{ section.settings.purity_heading }}</h2>
      {% endif %}
      {% if section.settings.purity_text != blank %}
        <p class="ap-sub">{{ section.settings.purity_text }}</p>
      {% endif %}

      {% if section.settings.purity_badge != blank %}
        <div class="ap-badge">
          {{ section.settings.purity_badge | image_url: width: 400 | image_tag: loading: 'lazy', alt: '' }}
        </div>
      {% endif %}

      <div class="ap-list">
        {% for block in checks %}
          <div class="ap-item" {{ block.shopify_attributes }}>
            <div class="ap-item-head">
              {% if block.settings.icon != blank %}
                <span class="ap-icon">{{ block.settings.icon | image_url: width: 140 | image_tag: loading: 'lazy', alt: '' }}</span>
              {% endif %}
              <h3 class="ap-item-title">{{ block.settings.title }}</h3>
            </div>
            {% if block.settings.text != blank %}
              <p class="ap-item-text">{{ block.settings.text }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      {% if section.settings.purity_image != blank %}
        <div class="ap-product">
          {{ section.settings.purity_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: '' }}
        </div>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

<script>
  (function () {
    var root = document.getElementById('{{ at_id }}');
    if (!root || root.dataset.atReady === 'true') return;
    root.dataset.atReady = 'true';

    var slides = Array.prototype.slice.call(root.querySelectorAll('[data-at-slide]'));
    var media = Array.prototype.slice.call(root.querySelectorAll('[data-at-media]'));
    var dots = Array.prototype.slice.call(root.querySelectorAll('[data-at-dot]'));
    if (slides.length < 2) return;

    var current = 0;
    var timer = null;
    var seconds = parseInt(root.dataset.autoplay, 10) || 0;

    function show(index) {
      current = (index + slides.length) % slides.length;
      slides.forEach(function (el, i) { el.classList.toggle('is-current', i === current); });
      media.forEach(function (el, i) { el.classList.toggle('is-current', i === current); });
      dots.forEach(function (el, i) { el.classList.toggle('is-current', i === current); });
    }

    function stop() {
      if (timer) { clearInterval(timer); timer = null; }
    }

    function start() {
      stop();
      if (seconds > 0) timer = setInterval(function () { show(current + 1); }, seconds * 1000);
    }

    function go(index) {
      show(index);
      start();
    }

    var prev = root.querySelector('[data-at-prev]');
    var next = root.querySelector('[data-at-next]');
    if (prev) prev.addEventListener('click', function () { go(current - 1); });
    if (next) next.addEventListener('click', function () { go(current + 1); });
    dots.forEach(function (dot) {
      dot.addEventListener('click', function () { go(parseInt(dot.dataset.atDot, 10)); });
    });

    var startX = null;
    root.addEventListener('touchstart', function (e) { startX = e.touches[0].clientX; }, { passive: true });
    root.addEventListener('touchend', function (e) {
      if (startX === null) return;
      var diff = e.changedTouches[0].clientX - startX;
      startX = null;
      if (Math.abs(diff) > 50) go(diff < 0 ? current + 1 : current - 1);
    }, { passive: true });

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    start();
  })();
</script>

{% schema %}
{
  "name": "Advertorial Testimonial",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "In their words"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What women noticed."
    },
    {
      "type": "header",
      "content": "Image layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "image_placeholder_color",
      "label": "Image placeholder color",
      "default": "#5C594E",
      "info": "Shown as a plain block until an image is uploaded."
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "range",
      "id": "autoplay",
      "label": "Auto-rotate (seconds)",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 0,
      "info": "0 turns auto-rotation off. It pauses while the mouse is over the section."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#1B1A18"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Eyebrow color",
      "default": "#C8A968"
    },
    {
      "type": "color",
      "id": "mark_color",
      "label": "Quote mark color",
      "default": "#6B6B6B"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Space inside the colored background, above the content."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Space inside the colored background, below the content."
    },
    {
      "type": "header",
      "content": "Purity screen (mobile only)"
    },
    {
      "type": "paragraph",
      "content": "This block only appears on phones, under the testimonials. It is hidden on tablet and desktop. Add its checks as “Purity check” blocks."
    },
    {
      "type": "text",
      "id": "purity_heading",
      "label": "Heading",
      "default": "India’s First 5-Point Purity Screen"
    },
    {
      "type": "text",
      "id": "purity_text",
      "label": "Subheading",
      "default": "Five key contaminant checks. Complete transparency."
    },
    {
      "type": "image_picker",
      "id": "purity_badge",
      "label": "Award badge",
      "info": "Shown at the top right."
    },
    {
      "type": "image_picker",
      "id": "purity_image",
      "label": "Product image",
      "info": "Shown at the bottom right, behind the text."
    },
    {
      "type": "color",
      "id": "purity_background",
      "label": "Background color",
      "default": "#F4F2EE"
    }
  ],
  "presets": [
    {
      "name": "Advertorial Testimonial",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "blocks": [
    {
      "type": "slide",
      "name": "Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "info": "Quotation marks are added automatically.",
          "default": "I didn’t start taking ORBÉ expecting a huge change. I just wanted to feel a little more energetic and awake throughout the day."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Mahima."
        }
      ]
    },
    {
      "type": "check",
      "name": "Purity check",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Heavy Metals"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        }
      ]
    }
  ]
}
{% endschema %}
