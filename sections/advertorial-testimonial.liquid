{%- assign at_id = 'advertorial-testimonial-' | append: section.id -%}

{%- style -%}
  #{{ at_id }} {
    --at-accent: {{ section.settings.accent_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
  }

  #{{ at_id }} .at-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 100px;
    align-items: center;
  }

  #{{ at_id }} .at-grid.is-image-right .at-media {
    order: 2;
  }

  #{{ at_id }} .at-media {
    max-width: 470px;
    margin-left: auto;
    aspect-ratio: 0.97 / 1;
    overflow: hidden;
    background: {{ section.settings.image_placeholder_color }};
  }

  #{{ at_id }} .at-media img,
  #{{ at_id }} .at-media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #{{ at_id }} .at-eyebrow {
    margin: 0 0 6px;
    color: var(--at-accent);
    font-family: var(--aspekta);
    font-size: 15px;
    line-height: 150%;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  #{{ at_id }} .at-title {
    margin: 0;
    color: #fff;
    font-family: var(--tobias);
    font-size: clamp(34px, 3.6vw, 54px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  #{{ at_id }} .at-quote-wrap {
    position: relative;
    max-width: 590px;
    margin-top: 56px;
  }

  #{{ at_id }} .at-mark {
    position: absolute;
    width: 52px;
    color: {{ section.settings.mark_color }};
  }

  #{{ at_id }} .at-mark svg {
    display: block;
    width: 100%;
    height: auto;
  }

  #{{ at_id }} .at-mark-open {
    top: 0;
    left: -58px;
  }

  #{{ at_id }} .at-mark-close {
    right: 0;
    bottom: 0;
  }

  #{{ at_id }} .at-quote {
    margin: 0;
    color: #f2efe9;
    font-family: var(--tobias);
    font-size: clamp(20px, 1.9vw, 27px);
    font-style: italic;
    font-weight: 400;
    line-height: 1.7;
  }

  #{{ at_id }} .at-author {
    margin: 10px 0 0;
    color: #d6d2cc;
    font-family: var(--aspekta);
    font-size: 18px;
    line-height: 1.3;
  }

  @media (max-width: 991px) {
    #{{ at_id }} .at-grid {
      gap: 60px;
    }

    #{{ at_id }} .at-quote-wrap {
      padding-left: 0;
    }
  }

  @media (max-width: 767px) {
    #{{ at_id }} .at-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    #{{ at_id }} .at-grid .at-media,
    #{{ at_id }} .at-grid.is-image-right .at-media {
      order: -1;
      max-width: none;
      margin-left: 0;
    }

    #{{ at_id }} .at-eyebrow {
      font-size: 12px;
    }

    #{{ at_id }} .at-quote-wrap {
      margin-top: 36px;
      padding-top: 40px;
    }

    #{{ at_id }} .at-mark {
      width: 36px;
    }

    #{{ at_id }} .at-mark-open {
      left: 0;
      top: 0;
    }

    #{{ at_id }} .at-mark-close {
      bottom: -6px;
    }

    #{{ at_id }} .at-author {
      font-size: 16px;
    }
  }
{%- endstyle -%}

<section class="advertorial-testimonial" id="{{ at_id }}">
  <div class="container">
    <div class="at-grid{% if section.settings.image_position == 'right' %} is-image-right{% endif %}">
      <div class="at-media">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: section.settings.author }}
        {% endif %}
      </div>

      <div class="at-content">
        {% if section.settings.eyebrow != blank %}
          <p class="at-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="at-title">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.quote != blank %}
          <div class="at-quote-wrap">
            <span class="at-mark at-mark-open" aria-hidden="true">
              <svg viewBox="0 0 52 40" fill="currentColor"><path d="M0 40V22.5C0 9.3 7.2 1.6 20.5 0l1.6 6.2C14.6 8 11.4 12 11.2 17.6h8.9V40H0Zm29.8 0V22.5C29.8 9.3 37 1.6 50.3 0l1.7 6.2c-7.5 1.8-10.7 5.8-10.9 11.4H50V40H29.8Z"/></svg>
            </span>
            <p class="at-quote">“{{ section.settings.quote }}”</p>
            {% if section.settings.author != blank %}
              <p class="at-author">{{ section.settings.author }}</p>
            {% endif %}
            <span class="at-mark at-mark-close" aria-hidden="true">
              <svg viewBox="0 0 52 40" fill="currentColor" style="transform: rotate(180deg)"><path d="M0 40V22.5C0 9.3 7.2 1.6 20.5 0l1.6 6.2C14.6 8 11.4 12 11.2 17.6h8.9V40H0Zm29.8 0V22.5C29.8 9.3 37 1.6 50.3 0l1.7 6.2c-7.5 1.8-10.7 5.8-10.9 11.4H50V40H29.8Z"/></svg>
            </span>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Advertorial Testimonial",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "In their words"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What women noticed."
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "info": "Quotation marks are added automatically.",
      "default": "I didn’t start taking ORBÉ expecting a huge change. I just wanted to feel a little more energetic and awake throughout the day."
    },
    {
      "type": "text",
      "id": "author",
      "label": "Author",
      "default": "Mahima."
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "image_placeholder_color",
      "label": "Image placeholder color",
      "default": "#5C594E",
      "info": "Shown as a plain block until an image is uploaded."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#1B1A18"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Eyebrow color",
      "default": "#C8A968"
    },
    {
      "type": "color",
      "id": "mark_color",
      "label": "Quote mark color",
      "default": "#6B6B6B"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Space inside the colored background, above the content."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Space inside the colored background, below the content."
    }
  ],
  "presets": [
    {
      "name": "Advertorial Testimonial"
    }
  ]
}
{% endschema %}
