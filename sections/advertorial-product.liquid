{%- assign ap_id = 'advertorial-product-' | append: section.id -%}

{%- style -%}
  #{{ ap_id }} {
    --ap-accent: {{ section.settings.accent_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
  }

  #{{ ap_id }} .ap-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
    align-items: start;
  }

  #{{ ap_id }} .ap-grid.is-image-right .ap-media {
    order: 2;
  }

  #{{ ap_id }} .ap-media {
    aspect-ratio: 0.875 / 1;
    overflow: hidden;
    background: #f4ead9;
  }

  #{{ ap_id }} .ap-media img,
  #{{ ap_id }} .ap-media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #{{ ap_id }} .ap-eyebrow {
    margin: 0 0 22px;
    color: var(--ap-accent);
    font-family: var(--aspekta);
    font-size: 15px;
    line-height: 150%;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #{{ ap_id }} .ap-title {
    margin: 0 0 26px;
    max-width: 11em;
    color: #151515;
    font-family: var(--tobias);
    font-size: clamp(34px, 3.6vw, 52px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  #{{ ap_id }} .ap-text {
    margin: 0;
    max-width: 28em;
    color: #5d5d5d;
    font-family: var(--aspekta);
    font-size: 18px;
    line-height: 140%;
  }

  #{{ ap_id }} .ap-quote {
    margin: 50px 0 0;
    padding: 4px 0 4px 18px;
    border-left: 1px solid var(--ap-accent);
    color: var(--ap-accent);
    font-family: var(--tobias);
    font-size: clamp(20px, 1.9vw, 28px);
    font-style: italic;
    font-weight: 400;
    line-height: 1.4;
  }

  #{{ ap_id }} .ap-features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 34px 30px;
    margin-top: 60px;
  }

  #{{ ap_id }} .ap-feature {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    column-gap: 16px;
    align-items: center;
  }

  #{{ ap_id }} .ap-feature-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: {{ section.settings.icon_background }};
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  #{{ ap_id }} .ap-feature-icon img {
    width: 55%;
    height: 55%;
    object-fit: contain;
    display: block;
  }

  #{{ ap_id }} .ap-feature-title {
    margin: 0 0 3px;
    color: #151515;
    font-family: var(--tobias);
    font-size: 21px;
    font-weight: 400;
    line-height: 1.2;
  }

  #{{ ap_id }} .ap-feature-text {
    margin: 0;
    color: #5d5d5d;
    font-family: var(--aspekta);
    font-size: 14px;
    line-height: 120%;
  }

  #{{ ap_id }} .ap-button-wrap {
    display: flex;
    justify-content: center;
    margin-top: 44px;
  }

  #{{ ap_id }} .ap-button {
    display: inline-block;
    min-width: 250px;
    padding: 16px 36px;
    border-radius: 50px;
    background: #111;
    color: #fff;
    font-family: var(--aspekta);
    font-size: 15px;
    line-height: 1;
    text-align: center;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  #{{ ap_id }} .ap-button:hover {
    opacity: 0.8;
  }

  @media (max-width: 991px) {
    #{{ ap_id }} .ap-grid {
      gap: 36px;
    }

    #{{ ap_id }} .ap-features {
      margin-top: 40px;
    }
  }

  @media (max-width: 767px) {
    #{{ ap_id }} .ap-grid {
      grid-template-columns: 1fr;
    }

    #{{ ap_id }} .ap-grid.is-image-right .ap-media {
      order: 0;
    }

    #{{ ap_id }} .ap-eyebrow {
      font-size: 12px;
      margin-bottom: 16px;
    }

    #{{ ap_id }} .ap-text {
      font-size: 16px;
    }

    #{{ ap_id }} .ap-quote {
      margin-top: 32px;
    }

    #{{ ap_id }} .ap-features {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    #{{ ap_id }} .ap-button-wrap {
      justify-content: flex-start;
    }

    #{{ ap_id }} .ap-button {
      width: 100%;
      min-width: 0;
    }
    .advertorial-product {
      padding: 60px 0!important;
    }
  }
{%- endstyle -%}

<section class="advertorial-product" id="{{ ap_id }}">
  <div class="container">
    <div class="ap-grid{% if section.settings.image_position == 'right' %} is-image-right{% endif %}">
      <div class="ap-media">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.image.alt | default: section.settings.heading }}
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>

      <div class="ap-content">
        {% if section.settings.eyebrow != blank %}
          <p class="ap-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="ap-title">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <p class="ap-text">{{ section.settings.text }}</p>
        {% endif %}

        {% if section.settings.quote != blank %}
          <blockquote class="ap-quote">{{ section.settings.quote }}</blockquote>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <div class="ap-features">
            {% for block in section.blocks %}
              <div class="ap-feature" {{ block.shopify_attributes }}>
                <span class="ap-feature-icon">
                  {% if block.settings.icon != blank %}
                    {{ block.settings.icon | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
                  {% endif %}
                </span>
                <div>
                  <h3 class="ap-feature-title">{{ block.settings.title }}</h3>
                  {% if block.settings.text != blank %}
                    <p class="ap-feature-text">{{ block.settings.text }}</p>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}

        {% if section.settings.button_text != blank %}
          <div class="ap-button-wrap">
            <a class="ap-button" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_text }}</a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Advertorial Product",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Meet ORBÉ N°01"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Daily Foundation, In Two Capsules"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Paragraph",
      "default": "ORBÉ N°01 is a multivitamin and multimineral with DHA, made for women. It brings essential nourishment into one daily routine."
    },
    {
      "type": "text",
      "id": "quote",
      "label": "Quote",
      "default": "Two capsules a day. One bottle. No shelf of guesswork."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop Orbé N°01"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#A8863F"
    },
    {
      "type": "color",
      "id": "icon_background",
      "label": "Icon circle color",
      "default": "#F4EBDC"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Space inside the background, above the content."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Space inside the background, below the content."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon",
          "info": "Small line icon (PNG, SVG or WebP), shown inside the circle."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Clean"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Advertorial Product",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Clean",
            "text": "No fillers, no artificial additives."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Bioavailable forms",
            "text": "Selected nutrient forms for your daily routine."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Gentle",
            "text": "Includes chelated mineral forms."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Vegan sources",
            "text": "Plant-based sources for selected nutrients."
          }
        }
      ]
    }
  ]
}
{% endschema %}
