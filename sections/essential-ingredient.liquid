<section class="essential-ingredient" id="essential-ingredient-{{ section.id }}">
    <div class="container">
        <div class="top">
            <div class="top-left">
                <div class="heading text-animation">
                    {% if section.settings.heading != blank %}
                    <h2>{{ section.settings.heading }}</h2>
                    {% endif %}
                    {% if section.settings.description != blank %}
                    <p>{{ section.settings.description }}</p>
                    {% endif %}
                </div>
            </div>
            <div class="top-right">
                {% if section.settings.link_text != blank %}
                <a href="#essential-ingredient-drawer-{{ section.id }}" class="open-ingredients">{{
                    section.settings.link_text }}</a>
                {% endif %}
            </div>
        </div>
        <div class="essential-ingredient-in">
            <div class="left">
                <div class="box-img">
                    {% assign box_blocks = section.blocks | where: 'type', 'accordion_item' %}
                    {% for block in box_blocks %}
                        {% assign phase_image = block.settings.image | default: section.settings.box_image %}
                        {% assign phase_image_tablet = block.settings.image_tablet | default: section.settings.box_image_tablet %}
                        {% if phase_image != blank %}
                        <div class="box-img-item{% if forloop.first %} is-active{% endif %}" data-box-image="{{ forloop.index0 }}">
                            <picture>
                                {% if phase_image_tablet != blank %}
                                <source media="(min-width: 768px) and (max-width: 1200px)" srcset="{{ phase_image_tablet | image_url: width: 900 }}">
                                {% endif %}
                                {{ phase_image | image_url: width: 900 | image_tag: alt: '', class: 'icon' }}
                            </picture>
                        </div>
                        {% endif %}
                    {% else %}
                        {% if section.settings.box_image != blank %}
                        <div class="box-img-item is-active">
                            {{ section.settings.box_image | image_url: width: 900 | image_tag: alt: '', class: 'icon' }}
                        </div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
            <div class="right">
                <div class="capsule-img">
                    {% if section.settings.capsule_image != blank %}
                    {{ section.settings.capsule_image | image_url: width: 300 | image_tag: alt: '', class: 'icon' }}
                    {% endif %}
                </div>
                <div class="accordion-wrap essential-ingredient">
                    <div class="accordion">
                        {% assign item_open = false %}
                        {% assign item_index = 0 %}
                        {% for block in section.blocks %}
                        {% case block.type %}
                        {% when 'accordion_item' %}
                        {% if item_open %}
                            </div>
                        </div>
                        {% endif %}
                        {% assign item_open = true %}
                        <div class="accordion-item" data-accordion-index="{{ item_index }}" {{ block.shopify_attributes }}>
                            <div class="accordion-title">
                                {{ block.settings.title }}
                                <span class="accordion-icon">
                                    {% render 'plus-accord-icon' %}
                                </span>
                            </div>
                            <div class="accordion-content">
                                {% assign phase_image = block.settings.image | default: section.settings.box_image %}
                                {% if phase_image != blank %}
                                <div class="accordion-content-img">
                                    {{ phase_image | image_url: width: 900 | image_tag: alt: '', class: 'icon' }}
                                </div>
                                {% endif %}
                                {% if block.settings.content != blank %}
                                <div class="accordioncontent-in">
                                    {{ block.settings.content }}
                                </div>
                                {% endif %}
                        {% assign item_index = item_index | plus: 1 %}
                        {% when 'accordion_text' %}
                                {% if item_open and block.settings.text != blank %}
                                <p class="accordion-extra-text{% if block.settings.style == 'footnote' %} accordion-extra-text-footnote{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
                                {% endif %}
                        {% when 'accordion_image' %}
                                {% assign extra_image = block.settings.image | default: block.settings.image_desktop %}
                                {% if item_open and extra_image != blank %}
                                {% assign extra_alt = extra_image.alt | escape %}
                                <div class="accordion-table-img" {{ block.shopify_attributes }}>
                                    <picture>
                                        {% if block.settings.image_desktop != blank %}
                                        <source media="(min-width: 768px)" srcset="{{ block.settings.image_desktop | image_url: width: 900 }} 900w, {{ block.settings.image_desktop | image_url: width: 1400 }} 1400w" sizes="45vw">
                                        {% endif %}
                                        {{ extra_image | image_url: width: 1200 | image_tag: alt: extra_alt, class: 'img', widths: '600, 900, 1200', sizes: '100vw' }}
                                    </picture>
                                </div>
                                {% endif %}
                        {% endcase %}
                        {% endfor %}
                        {% if item_open %}
                            </div>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
        <div class="top-right top-right-mobile">
            {% if section.settings.link_text != blank %}
            <a href="#essential-ingredient-drawer-{{ section.id }}" class="open-ingredients">{{
                section.settings.link_text }}</a>
            {% endif %}
        </div>
    </div>
    <div class="ingredient-drawer-backdrop" data-ingredient-drawer-close></div>
    <aside class="ingredient-drawer" id="essential-ingredient-drawer-{{ section.id }}" aria-hidden="true">
        <div class="ingredient-drawer-scroll" data-lenis-prevent>
            <div class="ingredient-drawer-head">
                {% if section.settings.drawer_eyebrow != blank %}
                <p>{{ section.settings.drawer_eyebrow }}</p>
                {% endif %}
                <button type="button" class="ingredient-drawer-close" aria-label="Close ingredients"
                    data-ingredient-drawer-close>
                    <span></span>
                    <span></span>
                </button>
            </div>
            <div class="ingredient-top-title">
                {% if section.settings.drawer_heading != blank %}
                <h2>{{ section.settings.drawer_heading }}</h2>
                {% endif %}
            </div>
            {% if section.settings.inactive_heading != blank or section.settings.inactive_text != blank %}
            <div class="ingredient-drawer-section">
                {% if section.settings.inactive_heading != blank %}
                <h2>{{ section.settings.inactive_heading }}</h2>
                {% endif %}
                {% assign inactive_lines = section.settings.inactive_text | newline_to_br | split: '<br />' %}
                {% for line in inactive_lines %}
                {% assign clean_line = line | strip %}
                {% if clean_line != blank %}
                <p>{{ clean_line }}</p>
                {% endif %}
                {% endfor %}
            </div>
            {% endif %}

            {% if section.settings.fill_weight_heading != blank or section.settings.fill_weight_text != blank %}
            <div class="ingredient-drawer-section">
                {% if section.settings.fill_weight_heading != blank %}
                <h2>{{ section.settings.fill_weight_heading }}</h2>
                {% endif %}
                {% assign fill_lines = section.settings.fill_weight_text | newline_to_br | split: '<br />' %}
                {% for line in fill_lines %}
                {% assign clean_line = line | strip %}
                {% if clean_line != blank %}
                <p>{{ clean_line }}</p>
                {% endif %}
                {% endfor %}
            </div>
            {% endif %}

            {% if section.settings.appearance_heading != blank or section.settings.appearance_text != blank %}
            <div class="ingredient-drawer-section">
                {% if section.settings.appearance_heading != blank %}
                <h2>{{ section.settings.appearance_heading }}</h2>
                {% endif %}
                {% if section.settings.appearance_text != blank %}
                <p>{{ section.settings.appearance_text }}</p>
                {% endif %}
            </div>
            {% endif %}

            {% for block in section.blocks %}
                {% if block.type == 'drawer_section' %}
                <div class="ingredient-drawer-section" {{ block.shopify_attributes }}>
                    {% if block.settings.heading != blank %}
                    <h2>{{ block.settings.heading }}</h2>
                    {% endif %}
                    {{ block.settings.text }}
                </div>
                {% elsif block.type == 'accordion_section' %}
                <div class="ingredient-drawer-item" {{ block.shopify_attributes }}>
                    <button type="button" class="ingredient-drawer-title">
                        <span>{{ block.settings.heading }}</span>
                        <span class="ingredient-drawer-icon">{% render 'plus-accord-icon' %}</span>
                    </button>
                    <div class="ingredient-drawer-content">
                        {{ block.settings.text }}
                    </div>
                </div>
                {% endif %}
            {% endfor %}

            {% if section.settings.nutrition_heading != blank or section.settings.nutrition_table_image != blank %}
            <div class="ingredient-drawer-section ingredient-drawer-nutrition">
                {% if section.settings.nutrition_heading != blank %}
                <h2>{{ section.settings.nutrition_heading }}</h2>
                {% endif %}
                {% if section.settings.nutrition_text != blank %}
                <p>{{ section.settings.nutrition_text }}</p>
                {% endif %}
                {% if section.settings.nutrition_table_image != blank %}
                <div class="ingredient-drawer-table-img">
                    {{ section.settings.nutrition_table_image | image_url: width: 900 | image_tag: alt: '', class: 'img'
                    }}
                </div>
                {% endif %}
            </div>
            {% endif %}
        </div>
    </aside>
</section>
<script>
    (function () {
        function initEssentialIngredientAccordion() {
            var section = document.getElementById('essential-ingredient-{{ section.id }}');
            if (!section || section.dataset.accordionReady === 'true') return;

            section.dataset.accordionReady = 'true';

            var titles = Array.prototype.slice.call(section.querySelectorAll('.accordion-title'));

            function closeItem(title) {
                var panel = title.nextElementSibling;
                title.classList.remove('active');
                if (panel) panel.style.maxHeight = '0px';
            }

            var boxImages = Array.prototype.slice.call(section.querySelectorAll('[data-box-image]'));

            function setActiveBoxImage(index) {
                if (!boxImages.length) return;
                boxImages.forEach(function (image) {
                    image.classList.toggle('is-active', image.dataset.boxImage === String(index));
                });
            }

            function openItem(title) {
                var panel = title.nextElementSibling;
                title.classList.add('active');
                if (panel) panel.style.maxHeight = panel.scrollHeight + 'px';

                var item = title.closest('.accordion-item');
                if (item && item.dataset.accordionIndex !== undefined) {
                    setActiveBoxImage(item.dataset.accordionIndex);
                }
            }

            if (titles.length) {
                titles.forEach(function (title) {
                    title.addEventListener('click', function () {
                        var isActive = title.classList.contains('active');

                        titles.forEach(function (item) {
                            if (item !== title) closeItem(item);
                        });

                        if (isActive) {
                            closeItem(title);
                        } else {
                            openItem(title);
                        }
                    });
                });

                openItem(titles[0]);
            }

            section.querySelectorAll('.accordion-table-img img').forEach(function (img) {
                img.addEventListener('load', function () {
                    var activeTitle = section.querySelector('.accordion-title.active');
                    if (activeTitle) openItem(activeTitle);
                });
            });

            var openButtons = section.querySelectorAll('.open-ingredients');
            var drawer = section.querySelector('.ingredient-drawer');
            var drawerCloseButtons = section.querySelectorAll('[data-ingredient-drawer-close]');
            var drawerTitles = Array.prototype.slice.call(section.querySelectorAll('.ingredient-drawer-title'));

            function closeDrawerItem(title) {
                var panel = title.nextElementSibling;
                title.classList.remove('active');
                if (panel) panel.style.maxHeight = '0px';
            }

            function openDrawerItem(title) {
                var panel = title.nextElementSibling;
                title.classList.add('active');
                if (panel) panel.style.maxHeight = panel.scrollHeight + 'px';
            }

            function openDrawer() {
                if (!drawer) return;
                drawer.setAttribute('aria-hidden', 'false');
                section.classList.add('ingredient-drawer-active');
                document.documentElement.classList.add('ingredient-drawer-open');
                document.body.classList.add('ingredient-drawer-open');
                if (drawerTitles.length) openDrawerItem(drawerTitles[0]);
                if (window.lenis) window.lenis.stop();
            }

            function closeDrawer() {
                if (!drawer) return;
                drawer.setAttribute('aria-hidden', 'true');
                section.classList.remove('ingredient-drawer-active');
                document.documentElement.classList.remove('ingredient-drawer-open');
                document.body.classList.remove('ingredient-drawer-open');
                if (window.lenis) window.lenis.start();
            }

            openButtons.forEach(function (button) {
                button.addEventListener('click', function (event) {
                    event.preventDefault();
                    openDrawer();
                });
            });

            drawerCloseButtons.forEach(function (button) {
                button.addEventListener('click', closeDrawer);
            });

            drawerTitles.forEach(function (title) {
                title.addEventListener('click', function () {
                    var isActive = title.classList.contains('active');

                    drawerTitles.forEach(function (item) {
                        if (item !== title) closeDrawerItem(item);
                    });

                    if (isActive) {
                        closeDrawerItem(title);
                    } else {
                        openDrawerItem(title);
                    }
                });
            });

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') closeDrawer();
            });

            window.addEventListener('resize', function () {
                var activeTitle = section.querySelector('.accordion-title.active');
                if (activeTitle) openItem(activeTitle);
                var activeDrawerTitle = section.querySelector('.ingredient-drawer-title.active');
                if (activeDrawerTitle) openDrawerItem(activeDrawerTitle);
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initEssentialIngredientAccordion);
        } else {
            initEssentialIngredientAccordion();
        }
    })();
</script>

{% schema %}
{
"name": "Essential Ingredient",
"settings": [
{
"type": "text",
"id": "heading",
"label": "Heading"
},
{
"type": "textarea",
"id": "description",
"label": "Description"
},
{
"type": "text",
"id": "link_text",
"label": "Link Text"
},
{
"type": "text",
"id": "drawer_eyebrow",
"label": "Drawer Eyebrow"
},
{
"type": "text",
"id": "drawer_heading",
"label": "Drawer Heading"
},
{
"type": "text",
"id": "inactive_heading",
"label": "Inactive Heading"
},
{
"type": "textarea",
"id": "inactive_text",
"label": "Inactive Text"
},
{
"type": "text",
"id": "fill_weight_heading",
"label": "Fill Weight Heading"
},
{
"type": "textarea",
"id": "fill_weight_text",
"label": "Fill Weight Text"
},
{
"type": "text",
"id": "appearance_heading",
"label": "Product Appearance Heading"
},
{
"type": "textarea",
"id": "appearance_text",
"label": "Product Appearance Text"
},
{
"type": "text",
"id": "nutrition_heading",
"label": "Nutrition Heading"
},
{
"type": "textarea",
"id": "nutrition_text",
"label": "Nutrition Text"
},
{
"type": "image_picker",
"id": "nutrition_table_image",
"label": "Nutrition Table Image"
},
{
"type": "image_picker",
"id": "box_image",
"label": "Box Image"
},
{
"type": "image_picker",
"id": "box_image_tablet",
"label": "Box Image (tablet)",
"info": "Optional tablet version of the Box Image, used when an accordion row has no tablet image of its own."
},
{
"type": "image_picker",
"id": "capsule_image",
"label": "Capsule Image"
}
],
"blocks": [
{
"type": "accordion_item",
"name": "Accordion Item",
"settings": [
{
"type": "text",
"id": "title",
"label": "Title"
},
{
"type": "richtext",
"id": "content",
"label": "Content"
},
{
"type": "image_picker",
"id": "image",
"label": "Image",
"info": "Shown on the left when this accordion row is open. Falls back to the Box Image above if left blank."
},
{
"type": "image_picker",
"id": "image_tablet",
"label": "Tablet image",
"info": "Optional. Used on tablet widths (768px to 991px) so the image isn't cropped. Desktop and mobile keep using the Image above."
}
]
},
{
"type": "accordion_text",
"name": "Accordion Text",
"settings": [
{
"type": "textarea",
"id": "text",
"label": "Text",
"info": "Shown inside the accordion item above it, in the order of the blocks. Place it before or after an Accordion Image."
},
{
"type": "select",
"id": "style",
"label": "Style",
"options": [
{ "value": "normal", "label": "Normal" },
{ "value": "footnote", "label": "Footnote (small)" }
],
"default": "normal"
}
]
},
{
"type": "accordion_image",
"name": "Accordion Image",
"settings": [
{
"type": "image_picker",
"id": "image",
"label": "Mobile image",
"info": "Shown inside the accordion item above it, e.g. the comparison table. Add it after an Accordion Item block. Also used on desktop if no Desktop image is set."
},
{
"type": "image_picker",
"id": "image_desktop",
"label": "Desktop image",
"info": "Optional. Used on screens 768px and wider. Falls back to the Mobile image if left blank."
}
]
},
{
"type": "drawer_section",
"name": "Drawer Section",
"settings": [
{
"type": "text",
"id": "heading",
"label": "Heading"
},
{
"type": "richtext",
"id": "text",
"label": "Text"
}
]
},
{
"type": "accordion_section",
"name": "Drawer Accordion Item",
"settings": [
{
"type": "text",
"id": "heading",
"label": "Heading",
"info": "Shown as the clickable accordion row."
},
{
"type": "richtext",
"id": "text",
"label": "Text",
"info": "Revealed when this accordion row is expanded."
}
]
}
],
"presets": [
{
"name": "Essential Ingredient"
}
]
}
{% endschema %}