{%- assign rf_scroll_top = false -%}
{%- if section.settings.scroll_top_if_empty and section.settings.button_link == blank -%}
  {%- assign rf_scroll_top = true -%}
{%- endif -%}
<section class="ready-formula">
    
    <div class="ready-formula-in">
        <div class="left">
            <div class="container">
              <div class="rfleft-in">
                <div class="content-block text-animation">
                  {% if section.settings.heading != blank %}
                    {% if section.settings.heading_mobile != blank %}
                      <h2 class="rf-has-m"><span class="rf-d">{{ section.settings.heading }}</span><span class="rf-m">{{ section.settings.heading_mobile }}</span></h2>
                    {% else %}
                      <h2>{{ section.settings.heading }}</h2>
                    {% endif %}
                  {% endif %}
                  {% if section.settings.text != blank %}
                  <p>{{ section.settings.text }}</p>
                  {% endif %}
                  {% if section.settings.button_text != blank %}
                    {% if section.settings.button_text_mobile != blank %}
                      <a href="{{ section.settings.button_link }}" class="primary-btn rf-has-m"{% if rf_scroll_top %} data-scroll-top{% endif %}><span class="rf-d">{{ section.settings.button_text }}</span><span class="rf-m">{{ section.settings.button_text_mobile }}</span></a>
                    {% else %}
                      <a href="{{ section.settings.button_link }}" class="primary-btn"{% if rf_scroll_top %} data-scroll-top{% endif %}>{{ section.settings.button_text }}</a>
                    {% endif %}
                  {% endif %}
                </div>
              </div>
            </div>
        </div>
        <div class="right">
            {% if section.settings.image != blank %}
              {{ section.settings.image | image_url: width: 1200 | image_tag: alt: '', class: 'img' }}
            {% endif %}
        </div>
    </div>
    
</section>

{% if rf_scroll_top %}
<script>
  (function () {
    if (window.__rfScrollTopBound) return;
    window.__rfScrollTopBound = true;
    // no link set: the button takes the visitor back to the top of the page
    document.addEventListener('click', function (e) {
      var btn = e.target.closest && e.target.closest('[data-scroll-top]');
      if (!btn) return;
      e.preventDefault();
      if (window.lenis && typeof window.lenis.scrollTo === 'function') window.lenis.scrollTo(0);
      else window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  })();
</script>
{% endif %}

{% schema %}
{
  "name": "Ready Formula",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "heading_mobile",
      "label": "Heading (tablet & mobile)",
      "info": "Optional. If filled, tablet and mobile show this instead of the heading above."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
    {
      "type": "text",
      "id": "button_text_mobile",
      "label": "Button text (tablet & mobile)",
      "info": "Optional. If filled, tablet and mobile show this instead of the button text above."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "checkbox",
      "id": "scroll_top_if_empty",
      "label": "Scroll to top when the link is empty",
      "default": false,
      "info": "If the Button Link is empty, the button scrolls the page back to the top instead of reloading it."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Ready Formula"
    }
  ]
}
{% endschema %}
