{%- assign af_id = 'advertorial-fixes-' | append: section.id -%}

{%- style -%}
  #{{ af_id }} {
    --af-accent: {{ section.settings.accent_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
  }

  #{{ af_id }} .af-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 60px;
    align-items: end;
  }

  #{{ af_id }} .af-eyebrow {
    margin: 0 0 14px;
    color: var(--af-accent);
    font-family: var(--aspekta);
    font-size: 15px;
    line-height: 150%;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #{{ af_id }} .af-title {
    margin: 0 0 16px;
    max-width: 8em;
    color: #151515;
    font-family: var(--tobias);
    font-size: clamp(34px, 3.6vw, 52px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  #{{ af_id }} .af-text {
    margin: 0 0 36px;
    max-width: 24em;
    color: #5d5d5d;
    font-family: var(--aspekta);
    font-size: 18px;
    line-height: 125%;
  }

  #{{ af_id }} .af-media {
    max-width: 440px;
    aspect-ratio: 1.18 / 1;
    overflow: hidden;
    background: #ddd;
  }

  #{{ af_id }} .af-media img,
  #{{ af_id }} .af-media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #{{ af_id }} .af-list {
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 500px;
  }

  #{{ af_id }} .af-row {
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr) minmax(0, 1fr);
    column-gap: 14px;
    align-items: start;
    padding: 18px 0;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }

  #{{ af_id }} .af-row:first-child {
    border-top: 0;
  }

  #{{ af_id }} .af-row-number {
    color: var(--af-accent);
    font-family: var(--tobias);
    font-size: 22px;
    font-style: italic;
    font-weight: 400;
    line-height: 1.2;
  }

  #{{ af_id }} .af-row-title {
    margin: 0;
    color: #151515;
    font-family: var(--tobias);
    font-size: 20px;
    font-weight: 400;
    line-height: 1.2;
  }

  #{{ af_id }} .af-row-text {
    margin: 0;
    color: #5d5d5d;
    font-family: var(--aspekta);
    font-size: 12px;
    line-height: 150%;
  }

  @media (max-width: 991px) {
    #{{ af_id }} .af-grid {
      gap: 40px;
    }

    #{{ af_id }} .af-row {
      grid-template-columns: 44px minmax(0, 1fr);
      row-gap: 6px;
    }

    #{{ af_id }} .af-row-text {
      grid-column: 2;
    }
  }

  @media (max-width: 767px) {
    #{{ af_id }} .af-grid {
      grid-template-columns: 1fr;
    }

    #{{ af_id }} .af-eyebrow {
      font-size: 12px;
    }

    #{{ af_id }} .af-text {
      font-size: 16px;
      margin-bottom: 28px;
    }

    #{{ af_id }} .af-media {
      max-width: none;
    }

    #{{ af_id }} .af-row-text {
      font-size: 13px;
    }
    #{{ af_id }} .af-grid {
      gap: 20px;
    }
    #{{ af_id }} .af-row {
      grid-template-columns: 30px minmax(0, 1fr);
      padding: 12px 0;
    }
  }
{%- endstyle -%}

<section class="advertorial-fixes" id="{{ af_id }}">
  <div class="container">
    <div class="af-grid">
      <div class="af-left">
        {% if section.settings.eyebrow != blank %}
          <p class="af-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="af-title">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <p class="af-text">{{ section.settings.text }}</p>
        {% endif %}

        <div class="af-media">
          {% if section.settings.image != blank %}
            {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.image.alt | default: section.settings.heading }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
      </div>

      {% if section.blocks.size > 0 %}
        <ol class="af-list">
          {% for block in section.blocks %}
            <li class="af-row" {{ block.shopify_attributes }}>
              <span class="af-row-number">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
              <h3 class="af-row-title">{{ block.settings.title }}</h3>
              {% if block.settings.text != blank %}
                <p class="af-row-text">{{ block.settings.text }}</p>
              {% endif %}
            </li>
          {% endfor %}
        </ol>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Advertorial Fixes",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "What most of us try"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Common fixes that fall short."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Paragraph",
      "default": "When the tiredness won’t lift, most women reach for one of these."
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F3F0EB"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#A8863F"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Space inside the colored background, above the content."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Space inside the colored background, below the content."
    }
  ],
  "blocks": [
    {
      "type": "fix",
      "name": "Fix",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "One more coffee"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Advertorial Fixes",
      "blocks": [
        {
          "type": "fix",
          "settings": {
            "title": "One more coffee",
            "text": "It feels like a lift. But coffee and tea can reduce iron absorption when consumed alongside iron-rich meals."
          }
        },
        {
          "type": "fix",
          "settings": {
            "title": "A shelf of random bottles",
            "text": "Stacking supplements can make consistency harder and doubling up easier."
          }
        },
        {
          "type": "fix",
          "settings": {
            "title": "Pills you stop taking",
            "text": "When a supplement feels rough on the stomach, you quietly skip it."
          }
        },
        {
          "type": "fix",
          "settings": {
            "title": "Waiting for the weekend",
            "text": "Rest can help, but it may not address an underlying nutritional deficiency."
          }
        }
      ]
    }
  ]
}
{% endschema %}
