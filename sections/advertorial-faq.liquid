{%- assign af_id = 'advertorial-faq-' | append: section.id -%}
{%- assign afc_id = 'advertorial-final-cta-' | append: section.id -%}

{%- style -%}
  #{{ af_id }} {
    --af-accent: {{ section.settings.accent_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
  }

  #{{ af_id }} .afq-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 90px;
    align-items: center;
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
  }

  #{{ af_id }} .afq-grid.is-image-right .afq-media {
    order: 2;
  }

  #{{ af_id }} .afq-media {
    aspect-ratio: 0.81 / 1;
    overflow: hidden;
    background: #d9cfc6;
  }

  #{{ af_id }} .afq-media img,
  #{{ af_id }} .afq-media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #{{ af_id }} .afq-eyebrow {
    margin: 0 0 6px;
    color: var(--af-accent);
    font-family: var(--aspekta);
    font-size: 15px;
    line-height: 150%;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  #{{ af_id }} .afq-title {
    margin: 0 0 40px;
    color: #151515;
    font-family: var(--tobias);
    font-size: clamp(34px, 3.6vw, 54px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  #{{ af_id }} .afq-list {
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }

  #{{ af_id }} .afq-item {
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  #{{ af_id }} .afq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    padding: 24px 0;
    border: 0;
    background: none;
    color: #151515;
    font-family: var(--aspekta);
    font-size: 21px;
    line-height: 1.3;
    text-align: left;
    cursor: pointer;
  }

  #{{ af_id }} .afq-icon {
    position: relative;
    flex: 0 0 auto;
    width: 14px;
    height: 14px;
    color: var(--af-accent);
  }

  #{{ af_id }} .afq-icon::before,
  #{{ af_id }} .afq-icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 1.5px;
    background: currentColor;
    transform: translate(-50%, -50%);
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  #{{ af_id }} .afq-icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  #{{ af_id }} .afq-item.is-open .afq-icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  #{{ af_id }} .afq-answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s ease;
  }

  #{{ af_id }} .afq-item.is-open .afq-answer {
    grid-template-rows: 1fr;
  }

  #{{ af_id }} .afq-answer-inner {
    overflow: hidden;
  }

  #{{ af_id }} .afq-answer-body {
    padding: 0 40px 24px 0;
    color: #5d5d5d;
    font-family: var(--aspekta);
    font-size: 16px;
    line-height: 150%;
  }

  #{{ af_id }} .afq-answer-body p {
    margin: 0 0 10px;
  }

  #{{ af_id }} .afq-answer-body p:last-child {
    margin-bottom: 0;
  }

  #{{ af_id }} .afq-answer-body ul,
  #{{ af_id }} .afq-answer-body ol {
    margin: 0 0 10px;
    padding-left: 20px;
  }

  @media (max-width: 991px) {
    #{{ af_id }} .afq-grid {
      gap: 50px;
    }

    #{{ af_id }} .afq-question {
      font-size: 18px;
    }
  }

  @media (max-width: 767px) {
    #{{ af_id }} .afq-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    #{{ af_id }} .afq-grid .afq-media,
    #{{ af_id }} .afq-grid.is-image-right .afq-media {
      order: -1;
    }

    #{{ af_id }} .afq-eyebrow {
      font-size: 12px;
    }

    #{{ af_id }} .afq-title {
      margin-bottom: 24px;
    }

    #{{ af_id }} .afq-question {
      padding: 18px 0;
      font-size: 16px;
    }

    #{{ af_id }} .afq-answer-body {
      padding-right: 0;
      font-size: 15px;
    }
  }

.advertorial-final-cta {
  margin-bottom: -240px;
}
  #{{ afc_id }} {
    --afc-accent: {{ section.settings.cta_accent_color }};
    padding-top: {{ section.settings.cta_padding_top }}px;
    padding-bottom: {{ section.settings.cta_padding_bottom }}px;
    background: {{ section.settings.cta_background_color }};
  }

  #{{ afc_id }} .afc-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 80px;
    align-items: stretch;
  }

  #{{ afc_id }} .afc-grid.is-image-left .afc-media {
    order: -1;
  }

  #{{ afc_id }} .afc-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 40px 0;
  }

  #{{ afc_id }} .afc-eyebrow {
    margin: 0 0 14px;
    color: var(--afc-accent);
    font-family: var(--aspekta);
    font-size: 16px;
    line-height: 150%;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #{{ afc_id }} .afc-title {
    margin: 0 0 40px;
    max-width: 9em;
    color: #151515;
    font-family: var(--tobias);
    font-size: clamp(36px, 4vw, 60px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  #{{ afc_id }} .afc-text {
    margin: 0 0 30px;
    max-width: 24em;
    color: #6b665f;
    font-family: var(--tobias);
    font-size: clamp(20px, 1.9vw, 28px);
    font-style: italic;
    font-weight: 400;
    line-height: 1.65;
  }

  #{{ afc_id }} .afc-button {
    align-self: flex-start;
    display: inline-block;
    padding: 20px 38px;
    border-radius: 50px;
    background: #151515;
    color: #fff;
    font-family: var(--aspekta);
    font-size: 15px;
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  #{{ afc_id }} .afc-button:hover {
    opacity: 0.8;
  }

  #{{ afc_id }} .afc-media {
    min-height: 460px;
    overflow: hidden;
    background: #d9cfc6;
  }

  #{{ afc_id }} .afc-media img,
  #{{ afc_id }} .afc-media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 991px) {
    #{{ afc_id }} .afc-grid {
      gap: 40px;
    }
    .advertorial-final-cta {
      margin-bottom: -160px;
    }
  }

  @media (max-width: 767px) {
    .advertorial-final-cta {
      margin-bottom: -106px;
    }
    #{{ afc_id }} .afc-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    #{{ afc_id }} .afc-grid .afc-media,
    #{{ afc_id }} .afc-grid.is-image-left .afc-media {
      order: -1;
      min-height: 0;
      aspect-ratio: 1 / 1.1;
    }

    #{{ afc_id }} .afc-content {
      padding: 30px 0 60px 0;
    }

    #{{ afc_id }} .afc-eyebrow {
      font-size: 12px;
    }

    #{{ afc_id }} .afc-title {
      margin-bottom: 24px;
    }

    #{{ afc_id }} .afc-button {
      width: 100%;
      text-align: center;
    }
    .advertorial-faq {
      padding-top: 0px!important;
    }
  }

  #{{ afc_id }} .afc-disclaimer {
    padding: 22px 0;
    background: {{ section.settings.cta_disclaimer_background }};
  }

  #{{ afc_id }} .afc-disclaimer p {
    margin: 0;
    color: #7a7268;
    font-family: var(--aspekta);
    font-size: 13px;
    line-height: 1.55;
  }

  @media (max-width: 767px) {
    #{{ afc_id }} .afc-disclaimer {
      padding: 18px 0;
    }

    #{{ afc_id }} .afc-disclaimer p {
      font-size: 12px;
    }
  }
{%- endstyle -%}

<section class="advertorial-faq" id="{{ af_id }}" data-afq data-single="{{ section.settings.single_open }}">
  <div class="container">
    <div class="afq-grid{% if section.settings.image_position == 'right' %} is-image-right{% endif %}">
      <div class="afq-media">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: section.settings.heading }}
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>

      <div class="afq-content">
        {% if section.settings.eyebrow != blank %}
          <p class="afq-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="afq-title">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <div class="afq-list">
            {% for block in section.blocks %}
              <div class="afq-item" {{ block.shopify_attributes }}>
                <button type="button" class="afq-question" aria-expanded="false" data-afq-toggle>
                  <span>{{ block.settings.question }}</span>
                  <span class="afq-icon" aria-hidden="true"></span>
                </button>
                <div class="afq-answer">
                  <div class="afq-answer-inner">
                    <div class="afq-answer-body">{{ block.settings.answer }}</div>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% if section.settings.show_cta %}
<section class="advertorial-final-cta" id="{{ afc_id }}">
  <div class="container">
    <div class="afc-grid{% if section.settings.cta_image_position == 'left' %} is-image-left{% endif %}">
      <div class="afc-content">
        {% if section.settings.cta_eyebrow != blank %}
          <p class="afc-eyebrow">{{ section.settings.cta_eyebrow }}</p>
        {% endif %}

        {% if section.settings.cta_heading != blank %}
          <h2 class="afc-title">{{ section.settings.cta_heading }}</h2>
        {% endif %}

        {% if section.settings.cta_text != blank %}
          <p class="afc-text">{{ section.settings.cta_text | newline_to_br }}</p>
        {% endif %}

        {% if section.settings.cta_button_text != blank %}
          <a class="afc-button" href="{{ section.settings.cta_button_link | default: '#' }}">{{ section.settings.cta_button_text }}</a>
        {% endif %}
      </div>

      <div class="afc-media">
        {% if section.settings.cta_image != blank %}
          {{ section.settings.cta_image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: section.settings.cta_heading }}
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
    </div>
  </div>

  {% if section.settings.cta_disclaimer != blank %}
    <div class="afc-disclaimer">
      <div class="container">
        <p>{{ section.settings.cta_disclaimer }}</p>
      </div>
    </div>
  {% endif %}
</section>
{% endif %}

<script>
  (function () {
    var root = document.getElementById('{{ af_id }}');
    if (!root || root.dataset.afqReady === 'true') return;
    root.dataset.afqReady = 'true';

    var single = root.dataset.single === 'true';
    var items = Array.prototype.slice.call(root.querySelectorAll('.afq-item'));

    items.forEach(function (item) {
      var toggle = item.querySelector('[data-afq-toggle]');
      if (!toggle) return;

      toggle.addEventListener('click', function () {
        var willOpen = !item.classList.contains('is-open');

        if (single && willOpen) {
          items.forEach(function (other) {
            if (other === item) return;
            other.classList.remove('is-open');
            var otherToggle = other.querySelector('[data-afq-toggle]');
            if (otherToggle) otherToggle.setAttribute('aria-expanded', 'false');
          });
        }

        item.classList.toggle('is-open', willOpen);
        toggle.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
      });
    });
  })();
</script>

