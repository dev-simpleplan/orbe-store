{%- assign as_id = 'advertorial-story-' | append: section.id -%}

{%- style -%}
  #{{ as_id }} {
    --as-accent: {{ section.settings.accent_color }};
    background: #fff;
  }

  #{{ as_id }} .as-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 60px;
    align-items: center;
  }

  #{{ as_id }} .as-grid.is-image-left .as-media {
    order: -1;
  }

  #{{ as_id }} .as-eyebrow {
    margin: 0 0 22px;
    color: var(--as-accent);
    font-family: var(--aspekta);
    font-size: 15px;
    line-height: 150%;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #{{ as_id }} .as-title {
    margin: 0 0 26px;
    max-width: 12em;
    color: #151515;
    font-family: var(--tobias);
    font-size: clamp(34px, 3.6vw, 52px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  #{{ as_id }} .as-body,
  #{{ as_id }} .as-body p {
    color: #5d5d5d;
    font-family: var(--aspekta);
    font-size: 18px;
    line-height: 135%;
  }

  #{{ as_id }} .as-body p {
    margin: 0 0 22px;
  }

  #{{ as_id }} .as-body p:last-child {
    margin-bottom: 0;
  }

  #{{ as_id }} .as-quote {
    margin: 56px 0 0;
    padding: 4px 0 4px 32px;
    max-width: 30em;
    border-left: 1px solid var(--as-accent);
    color: var(--as-accent);
    font-family: var(--tobias);
    font-size: clamp(20px, 1.9vw, 26px);
    font-style: italic;
    font-weight: 400;
    line-height: 1.55;
  }

  #{{ as_id }} .as-media {
    aspect-ratio: 1.12 / 1;
    overflow: hidden;
    background: #f2f2f2;
  }

  #{{ as_id }} .as-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 991px) {
    #{{ as_id }} .as-grid {
      gap: 40px;
    }
  }

  @media (max-width: 767px) {
    #{{ as_id }} .as-grid {
      grid-template-columns: 1fr;
    }

    #{{ as_id }} .as-grid .as-media,
    #{{ as_id }} .as-grid.is-image-left .as-media {
      order: -1;
    }

    #{{ as_id }} .as-eyebrow {
      font-size: 12px;
      margin-bottom: 16px;
    }

    #{{ as_id }} .as-body,
    #{{ as_id }} .as-body p {
      font-size: 16px;
    }

    #{{ as_id }} .as-quote {
      margin-top: 36px;
      padding-left: 20px;
    }
  }
{%- endstyle -%}

<section class="advertorial-story" id="{{ as_id }}">
  <div class="container">
    <div class="as-grid{% if section.settings.image_position == 'left' %} is-image-left{% endif %}">
      <div class="as-content">
        {% if section.settings.eyebrow != blank %}
          <p class="as-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="as-title">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.body != blank %}
          <div class="as-body">{{ section.settings.body }}</div>
        {% endif %}

        {% if section.settings.quote != blank %}
          <blockquote class="as-quote">{{ section.settings.quote }}</blockquote>
        {% endif %}
      </div>

      <div class="as-media">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: section.settings.image.alt | default: section.settings.heading }}
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Advertorial Story",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The 3pm moment"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "It’s 3pm. Your Second Coffee’s Going Cold."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "info": "Each paragraph gets spacing between it. Use Shift + Enter for a line break inside a paragraph."
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "You’re not imagining it. These everyday shifts are your body’s way of asking for support."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#A8863F"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    }
  ],
  "presets": [
    {
      "name": "Advertorial Story"
    }
  ]
}
{% endschema %}
