{%- assign afd_id = 'advertorial-foundation-' | append: section.id -%}
{%- assign afd_count = section.blocks.size | at_least: 1 -%}

{%- style -%}
  #{{ afd_id }} {
    --afd-accent: {{ section.settings.accent_color }};
    --afd-count: {{ afd_count }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
  }

  #{{ afd_id }} .afd-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 60px;
    align-items: stretch;
  }

  #{{ afd_id }} .afd-left {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
  }

  #{{ afd_id }} .afd-eyebrow {
    margin: 0 0 30px;
    color: var(--afd-accent);
    font-family: var(--aspekta);
    font-size: 15px;
    line-height: 150%;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #{{ afd_id }} .afd-title {
    margin: 0;
    max-width: 8em;
    color: #151515;
    font-family: var(--tobias);
    font-size: clamp(36px, 4vw, 58px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  #{{ afd_id }} .afd-text {
    margin: 0;
    max-width: 26em;
    color: #5d5d5d;
    font-family: var(--aspekta);
    font-size: 18px;
    line-height: 140%;
  }

  #{{ afd_id }} .afd-media {
    aspect-ratio: 1.35 / 1;
    overflow: hidden;
    background: #ddd;
  }

  #{{ afd_id }} .afd-media img,
  #{{ afd_id }} .afd-media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #{{ afd_id }} .afd-steps {
    display: grid;
    grid-template-columns: repeat(var(--afd-count), minmax(0, 1fr));
    margin-top: 40px;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  #{{ afd_id }} .afd-step {
    padding: 22px 30px 28px;
    border-left: 1px solid rgba(0, 0, 0, 0.1);
  }

  #{{ afd_id }} .afd-step:first-child {
    border-left: 0;
    padding-left: 0;
  }

  #{{ afd_id }} .afd-step-number {
    display: block;
    margin-bottom: 4px;
    color: var(--afd-accent);
    font-family: var(--tobias);
    font-size: 38px;
    font-style: italic;
    font-weight: 400;
    line-height: 1.1;
  }

  #{{ afd_id }} .afd-step-title {
    margin: 0 0 8px;
    color: #151515;
    font-family: var(--tobias);
    font-size: 22px;
    font-weight: 400;
    line-height: 1.2;
  }

  #{{ afd_id }} .afd-step-text {
    margin: 0;
    color: #5d5d5d;
    font-family: var(--aspekta);
    font-size: 14px;
    line-height: 140%;
  }
  #{{ afd_id }} .afd-head {
    padding-top: 30px;
  }

  @media (max-width: 991px) {
    #{{ afd_id }} .afd-top {
      gap: 40px;
    }

    #{{ afd_id }} .afd-step {
      padding: 20px 20px 24px;
    }
    #{{ afd_id }} .afd-head {
    padding-top: 0px;
  }
  }

  @media (max-width: 767px) {
    #{{ afd_id }} .afd-top {
      grid-template-columns: 1fr;
    }

    #{{ afd_id }} .afd-media {
      order: -1;
    }

    #{{ afd_id }} .afd-eyebrow {
      font-size: 12px;
      margin-bottom: 16px;
    }

    #{{ afd_id }} .afd-text {
      font-size: 16px;
    }

    #{{ afd_id }} .afd-steps {
      grid-template-columns: 1fr;
      margin-top: 30px;
    }

    #{{ afd_id }} .afd-step,
    #{{ afd_id }} .afd-step:first-child {
      padding: 20px 0 22px;
      border-left: 0;
      border-top: 1px solid rgba(0, 0, 0, 0.1);
    }

    #{{ afd_id }} .afd-step:first-child {
      border-top: 0;
    }
    #{{ afd_id }} .afd-title {
      max-width: inherit;
    }
    #{{ afd_id }} .afd-left {
      gap: 30px;
    }
    .afd-top .afd-media {
      display: none;
    }
    .hide-md .afd-media {
      margin-top: 30px;
    }
    .advertorial-foundation {
      padding: 60px 0!important;
    }
  }
{%- endstyle -%}

<section class="advertorial-foundation" id="{{ afd_id }}">
  <div class="container">
    <div class="afd-top">
      <div class="afd-left">
        <div class="afd-head">
          {% if section.settings.eyebrow != blank %}
            <p class="afd-eyebrow">{{ section.settings.eyebrow }}</p>
          {% endif %}

          {% if section.settings.heading != blank %}
            <h2 class="afd-title">{{ section.settings.heading }}</h2>
          {% endif %}
        </div>

        {% if section.settings.text != blank %}
          <p class="afd-text">{{ section.settings.text | newline_to_br }}</p>
        {% endif %}
      </div>

      <div class="afd-media">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: section.settings.image.alt | default: section.settings.heading }}
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
    </div>

    {% if section.blocks.size > 0 %}
      <div class="afd-steps">
        {% for block in section.blocks %}
          <div class="afd-step" {{ block.shopify_attributes }}>
            <span class="afd-step-number">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            <h3 class="afd-step-title">{{ block.settings.title }}</h3>
            {% if block.settings.text != blank %}
              <p class="afd-step-text">{{ block.settings.text }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}

    
  </div>
</section>

{% schema %}
{
  "name": "Advertorial Foundation",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A simpler approach"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build a daily foundation."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Paragraph",
      "info": "Each new line is shown on its own line. Sits at the bottom of the left column.",
      "default": "Lasting wellbeing comes from three things working together.\nConsistency matters more than perfection.\nThat’s the idea behind ORBÉ N°01."
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FBFAF8"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#A8863F"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Space inside the background, above the content."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Space inside the background, below the content."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "The right nutrients"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Advertorial Foundation",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "The right nutrients",
            "text": "The ones Indian women most often run low on."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Forms your body can use",
            "text": "Selected nutrient forms, chosen with purpose."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "A routine you’ll keep",
            "text": "Simple enough to take every single day."
          }
        }
      ]
    }
  ]
}
{% endschema %}
