<section class="ingredients-science">
  <div class="container">
    <div class="ingredients-science__top">
      <div class="ingredients-science__media">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', alt: section.settings.heading }}
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>

      <div class="ingredients-science__content">
        {% if section.settings.heading != blank %}
          <h2 class="ingredients-science__title">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.text != blank %}
          <p class="ingredients-science__text">{{ section.settings.text }}</p>
        {% endif %}
      </div>
    </div>

    {% if section.blocks.size > 0 %}
      <div class="ingredients-science__stats">
        {%- for block in section.blocks -%}
          <div class="ingredients-science__stat" {{ block.shopify_attributes }}>
            <span class="ingredients-science__number">{{ block.settings.number }}</span>
            <p class="ingredients-science__stat-text">{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Ingredients Science",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Science You Can Understand"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Paragraph",
      "default": "At ORBÉ, every formulation begins with research — not trends.\nWe translate clinical insights into simple, supportive wellness designed for real life."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "89%" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Based on ingredient-level clinical research and nutritional evidence."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients Science",
      "blocks": [
        { "type": "stat" },
        {
          "type": "stat",
          "settings": {
            "number": "93%",
            "text": "Derived from validated studies on absorption, efficacy, and consistency."
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "60%",
            "text": "Reflects findings from peer-reviewed wellness and nutrition research."
          }
        }
      ]
    }
  ]
}
{% endschema %}
