<section class="see-through">
  <div class="st-mobile" id="st-mobile-{{ section.id }}">
    <div class="st-mobile-bg-sticky">
      <div class="st-mobile-bg">
        {% if section.settings.image_1 != blank %}
          {{ section.settings.image_1 | image_url: width: 1200 | image_tag: loading: 'lazy', alt: '' }}
        {% endif %}
      </div>
      <div class="st-mobile-overlay"></div>
    </div>

    <div class="st-mobile-content">
      {% if section.settings.heading != blank or section.settings.subheading != blank %}
        <div class="st-mobile-intro">
          {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
          {% if section.settings.subheading != blank %}<p>{{ section.settings.subheading }}</p>{% endif %}
        </div>
      {% endif %}

      {% assign qa_blocks = section.blocks | where: 'type', 'qa_item' %}
      {% if qa_blocks.size > 0 %}
        <div class="st-mobile-qa" data-st-qa>
          {% for block in qa_blocks %}
            <div class="st-mobile-qa-item{% if forloop.index0 >= 2 %} is-extra{% endif %}" data-st-qa-item {{ block.shopify_attributes }}>
              <p class="st-mobile-qa-label">Q{{ forloop.index }}</p>
              {% if block.settings.question != blank %}
                <h3 class="st-mobile-qa-question">{{ block.settings.question }}</h3>
              {% endif %}
              {% if block.settings.answer != blank %}
                <p class="st-mobile-qa-answer">{{ block.settings.answer }}</p>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}

      <div class="st-mobile-actions" data-st-actions-initial>
        {% if section.settings.mobile_button_1_text != blank %}
          <a class="primary-btn st-mobile-btn" href="{{ section.settings.mobile_button_1_link | default: '#' }}">{{ section.settings.mobile_button_1_text }}</a>
        {% endif %}
        {% if section.settings.mobile_button_2_text != blank and qa_blocks.size > 2 %}
          <button type="button" class="primary-btn st-mobile-btn" data-st-expand-trigger>{{ section.settings.mobile_button_2_text }}</button>
        {% endif %}
      </div>

      <div class="st-mobile-actions st-mobile-actions--expanded is-hidden" data-st-actions-expanded>
        {% if section.settings.mobile_expanded_cta_text != blank %}
          <a class="primary-btn st-mobile-btn" href="{{ section.settings.mobile_expanded_cta_link | default: '#' }}">{{ section.settings.mobile_expanded_cta_text }}</a>
        {% endif %}
        {% if section.settings.mobile_contact_note != blank %}
          {% if section.settings.mobile_contact_note_link != blank %}
            <a class="st-mobile-note" href="{{ section.settings.mobile_contact_note_link }}" target="_blank" rel="noopener">{{ section.settings.mobile_contact_note }}</a>
          {% else %}
            <p class="st-mobile-note">{{ section.settings.mobile_contact_note }}</p>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>

  <div class="container-left">
    <div class="see-through-in">
      <div class="st-struct-1">
        <div>
          {% if section.settings.heading != blank %}
            <h2>{{ section.settings.heading }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p>{{ section.settings.subheading }}</p>
          {% endif %}
        </div>
        <div class="st-media">
          {% render 'st-media', image: section.settings.image_1, video: section.settings.video_1, width: 900 %}
        </div>
        <div class="st-orbe-logo top">
          {% if section.settings.orbe_logo_top != blank %}
            {{ section.settings.orbe_logo_top | image_url: width: 500 | image_tag: alt: '', class: 'img' }}
          {% endif %}
        </div>
        <div class="st-question">
          {% if section.settings.side_text != blank %}
            <p>{{ section.settings.side_text }}</p>
          {% endif %}
        </div>
      </div>
      <div class="st-struct-2">
        <div class="st-media">
          {% render 'st-media', image: section.settings.image_2, video: section.settings.video_2, width: 500 %}
        </div>
        <div></div>
        <div class="st-media">
          {% render 'st-media', image: section.settings.image_3, video: section.settings.video_3, width: 500 %}
        </div>
        <div class="st-media">
          {% render 'st-media', image: section.settings.image_4, video: section.settings.video_4, width: 700 %}
        </div>
        <div class="st-orbe-logo bottom">
          {% if section.settings.orbe_logo_bottom != blank %}
            {{ section.settings.orbe_logo_bottom | image_url: width: 500 | image_tag: alt: '', class: 'img' }}
          {% endif %}
        </div>
      </div>
      {% comment %} <div class="st-orbe-logo">
        {% if section.settings.orbe_logo != blank %}
          {{ section.settings.orbe_logo | image_url: width: 500 | image_tag: alt: '', class: 'img' }}
        {% endif %}
      </div> {% endcomment %}
    </div>
    <div class="st-struct-3">
      <div></div>
      <div class="st-media">
        {% render 'st-media', image: section.settings.image_5, video: section.settings.video_5, width: 800 %}
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var stMobile = document.getElementById('st-mobile-{{ section.id }}');
    if (stMobile) {
      var expandTrigger = stMobile.querySelector('[data-st-expand-trigger]');
      var qaWrap = stMobile.querySelector('[data-st-qa]');
      var initialActions = stMobile.querySelector('[data-st-actions-initial]');
      var expandedActions = stMobile.querySelector('[data-st-actions-expanded]');

      if (expandTrigger) {
        expandTrigger.addEventListener('click', function () {
          if (qaWrap) qaWrap.classList.add('is-expanded');
          if (initialActions) initialActions.classList.add('is-hidden');
          if (expandedActions) expandedActions.classList.remove('is-hidden');
        });
      }
    }

    document.querySelectorAll('.see-through .st-video-wrap').forEach(function (wrap) {
      var video = wrap.querySelector('video');
      var btn = wrap.querySelector('.st-play');
      if (!video || !btn) return;

      function sync() {
        var playing = !video.paused && !video.ended;
        btn.classList.toggle('is-playing', playing);
        btn.setAttribute('aria-label', playing ? 'Pause' : 'Play');
      }

      btn.addEventListener('click', function () {
        if (video.paused || video.ended) {
          video.play();
        } else {
          video.pause();
        }
      });

      video.addEventListener('play', sync);
      video.addEventListener('pause', sync);
      sync();
    });
  })();
</script>

