<section class="at-single">
    <div class="container">
         <div class="heading text-animation">
                {% if section.settings.heading != blank %}
                    <h2>{{ section.settings.heading }}</h2>
                {% endif %}
            </div>
        <div class="at-single-in">
           
            <div class="at-single-image-block">
                <div class="at-single-bg">
                    {% if section.settings.media_type == 'video' %}
                        {% if section.settings.video != blank %}
                            {{ section.settings.video | video_tag: class: 'img', autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1200x' }}
                        {% elsif section.settings.image != blank %}
                            <img src="{{ section.settings.image | image_url }}" alt="" class="img">
                        {% endif %}
                    {% else %}
                        {% if section.settings.image != blank %}
                            <img src="{{ section.settings.image | image_url }}" alt="" class="img">
                        {% endif %}
                    {% endif %}
                </div>
                {% if section.settings.media_type == 'video' and section.settings.video != blank %}
                    <button type="button" class="at-single-mute" data-at-single-mute aria-label="Unmute video">
                        <svg class="at-icon-muted" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 6.2h2.1l3.4-2.7v9.2L5.1 9.8H3V6.2z" fill="currentColor"/><path d="m10.8 6 3.1 3.6M13.9 6l-3.1 3.6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                        <svg class="at-icon-unmuted" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 6.2h2.1l3.4-2.7v9.2L5.1 9.8H3V6.2z" fill="currentColor"/><path d="M10.6 5.3a4 4 0 0 1 0 5.4" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/><path d="M12.5 3.4a7 7 0 0 1 0 9.2" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/></svg>
                    </button>
                {% endif %}
                <span class="at-single-strike" aria-hidden="true"></span>
                <div class="orbe-motion-logo">
                    {% if section.settings.logo != blank %}
                        <img src="{{ section.settings.logo | image_url }}" alt="">
                    {% endif %}
                </div>
            </div>
            <div class="at-single-content-block text-animation">
                <div class="left">
                    {% if section.settings.left_text != blank %}
                        <p>{{ section.settings.left_text }}</p>
                    {% endif %}
                </div>
                <div class="right">
                    {% if section.settings.right_text != blank %}
                        <p>{{ section.settings.right_text }}</p>
                    {% endif %}
                    <div class="at-single-button">
                      {% if section.settings.button_text != blank %}
                          <a href="{{ section.settings.button_link }}" class="primary-btn">{{ section.settings.button_text }}</a>
                      {% endif %}
                    </div>
                </div>
            </div>
            
        </div>
    </div>
</section>

<script>
  (function () {
    var block = document.querySelector('.at-single-image-block');
    if (!block) return;

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-struck');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.4 });

    observer.observe(block);
  })();

  (function () {
    var video = document.querySelector('.at-single-bg video');
    var muteBtn = document.querySelector('[data-at-single-mute]');
    if (!video || !muteBtn) return;

    function syncMuteIcon() {
      muteBtn.classList.toggle('is-unmuted', !video.muted);
      muteBtn.setAttribute('aria-label', video.muted ? 'Unmute video' : 'Mute video');
    }

    muteBtn.addEventListener('click', function (event) {
      event.stopPropagation();
      video.muted = !video.muted;
      syncMuteIcon();
    });

    syncMuteIcon();
  })();
</script>

{% schema %}
{
  "name": "At Single",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Used when Media type is Image, or as a fallback if Video is empty."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Used when Media type is Video."
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "textarea",
      "id": "left_text",
      "label": "Left Text"
    },
    {
      "type": "textarea",
      "id": "right_text",
      "label": "Right Text"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "At Single"
    }
  ]
}
{% endschema %}
