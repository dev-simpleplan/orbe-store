{% comment %} Community Heading Section {% endcomment %}

<section class="community-heading">
  <div class="container">
    <div class="heading text-animation">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Community Heading",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join our community"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "A community shaped by learning, listening, and intention, created for thoughtful conversations and support."
    }
  ],
  "presets": [
    {
      "name": "Community Heading"
    }
  ]
}
{% endschema %}
