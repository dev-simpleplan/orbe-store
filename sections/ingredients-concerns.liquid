<section class="ingredients-concerns">
  <div class="container">
    <div class="ingredients-concerns__head">
      {% if section.settings.heading != blank %}
        <h2 class="ingredients-concerns__title">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <p class="ingredients-concerns__text">{{ section.settings.text }}</p>
      {% endif %}
    </div>

    <div class="ingredients-concerns__grid">
      {%- for block in section.blocks -%}
        <div class="ingredients-concerns__card" {{ block.shopify_attributes }}>
          <div class="ingredients-concerns__media">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: block.settings.title }}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
          {% if block.settings.title != blank %}
            <h3 class="ingredients-concerns__card-title">{{ block.settings.title }}</h3>
          {% endif %}
          {% if block.settings.text != blank %}
            <p class="ingredients-concerns__card-text">{{ block.settings.text }}</p>
          {% endif %}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ingredients Concerns",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Connecting Concerns To Nutrients"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Paragraph",
      "default": "Your body often communicates through everyday discomforts.\nUnderstanding what may support these functions helps you make informed choices."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Muscle Pain & Body Aches" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "May be linked to low magnesium or vitamin D levels, which support muscle function and recovery."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients Concerns",
      "blocks": [
        { "type": "card" },
        {
          "type": "card",
          "settings": {
            "title": "Constant Fatigue",
            "text": "Iron and B12 play a role in energy production and oxygen transport."
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Restless Sleep",
            "text": "Magnesium helps support relaxation and normal sleep cycles."
          }
        }
      ]
    }
  ]
}
{% endschema %}
