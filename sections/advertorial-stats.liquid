{%- assign ast_id = 'advertorial-stats-' | append: section.id -%}

{%- style -%}
  #{{ ast_id }} {
    --ast-accent: {{ section.settings.accent_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
  }

  #{{ ast_id }} .ast-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 60px;
    align-items: center;
  }

  #{{ ast_id }} .ast-eyebrow {
    margin: 0 0 22px;
    color: var(--ast-accent);
    font-family: var(--aspekta);
    font-size: 15px;
    line-height: 150%;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #{{ ast_id }} .ast-title {
    margin: 0 0 22px;
    max-width: 11em;
    color: #151515;
    font-family: var(--tobias);
    font-size: clamp(34px, 3.6vw, 52px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  #{{ ast_id }} .ast-text {
    margin: 0;
    max-width: 26em;
    color: #5d5d5d;
    font-family: var(--aspekta);
    font-size: 18px;
    line-height: 140%;
  }

  #{{ ast_id }} .ast-stats {
    display: flex;
    align-items: stretch;
    gap: 0;
  }

  #{{ ast_id }} .ast-stat {
    flex: 1 1 0;
    min-width: 0;
    padding: 0 16px;
    border-left: 1px solid rgba(0, 0, 0, 0.1);
  }

  #{{ ast_id }} .ast-number {
    margin: 0 0 8px;
    color: var(--ast-accent);
    font-family: var(--tobias);
    font-size: clamp(32px, 3.2vw, 46px);
    font-weight: 500;
    line-height: 1.1;
    white-space: nowrap;
  }

  #{{ ast_id }} .ast-label {
    margin: 0;
    max-width: 12em;
    color: #5d5d5d;
    font-family: var(--aspekta);
    font-size: 14px;
    line-height: 135%;
  }

  @media (max-width: 991px) {
    #{{ ast_id }} .ast-grid {
      gap: 40px;
    }

    #{{ ast_id }} .ast-stat {
      padding: 0 12px;
    }
  }

  @media (max-width: 767px) {
    #{{ ast_id }} .ast-grid {
      grid-template-columns: 1fr;
    }

    #{{ ast_id }} .ast-eyebrow {
      font-size: 12px;
      margin-bottom: 16px;
    }

    #{{ ast_id }} .ast-text {
      font-size: 16px;
    }

    #{{ ast_id }} .ast-stats {
      flex-direction: column;
      gap: 24px;
    }

    #{{ ast_id }} .ast-stat {
      padding: 4px 0 4px 20px;
    }

    #{{ ast_id }} .ast-label {
      max-width: none;
    }
  }
{%- endstyle -%}

<section class="advertorial-stats" id="{{ ast_id }}">
  <div class="container">
    <div class="ast-grid">
      <div class="ast-content">
        {% if section.settings.eyebrow != blank %}
          <p class="ast-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="ast-title">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <p class="ast-text">{{ section.settings.text }}</p>
        {% endif %}
      </div>

      {% if section.blocks.size > 0 %}
        <div class="ast-stats">
          {% for block in section.blocks %}
            <div class="ast-stat" {{ block.shopify_attributes }}>
              {% if block.settings.number != blank %}
                <p class="ast-number">{{ block.settings.number }}</p>
              {% endif %}
              {% if block.settings.label != blank %}
                <p class="ast-label">{{ block.settings.label }}</p>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Advertorial Stats",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why it happens"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Common Nutritional Gaps Run Deep In Indian Women"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Paragraph",
      "default": "A good diet covers most of your nutritional needs, but a few key nutrients can still fall short. These gaps are more common than you might think."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#EEE6DF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#A8863F"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Space inside the colored background, above the content."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Space inside the colored background, below the content."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "57%"
        },
        {
          "type": "textarea",
          "id": "label",
          "label": "Description",
          "default": "of Indian women aged 15–49 are anaemic."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Advertorial Stats",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "number": "57%",
            "label": "of Indian women aged 15–49 are anaemic."
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "70%+",
            "label": "B12 deficiency reported across the Indian population."
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "70–90%",
            "label": "of Indians are insufficient in Vitamin D."
          }
        }
      ]
    }
  ]
}
{% endschema %}
