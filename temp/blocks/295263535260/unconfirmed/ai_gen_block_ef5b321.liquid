{% doc %}
  @prompt
    html section to add code
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-custom-code-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    box-sizing: border-box;
  }
{% endstyle %}

<div class="ai-custom-code-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {{ block.settings.custom_html }}
</div>

{% schema %}
{
  "name": "Custom HTML",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "html",
      "id": "custom_html",
      "label": "HTML code"
    }
  ],
  "presets": [
    {
      "name": "Custom HTML"
    }
  ],
  "tag": null,
  "class": "custom-html-block"
}
{% endschema %}