{% doc %}
  @prompt
    html section to add code, make it as custom liquid
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-custom-liquid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    box-sizing: border-box;
  }
{% endstyle %}

<div class="ai-custom-liquid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.custom_liquid != blank %}
    {{ block.settings.custom_liquid }}
  {% endif %}
</div>

{% schema %}
{
  "name": "Custom liquid",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Liquid code"
    }
  ],
  "presets": [
    {
      "name": "Custom liquid"
    }
  ],
  "tag": null,
  "class": "custom-liquid-block"
}
{% endschema %}